---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  /* Article metadata – LinkedIn, Google and other scrapers read these
     for the author and publish date. Only emitted when ogType is 'article'. */
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
}

const {
  title,
  description = "I partner with founders, execs and their teams to make their marketing and go-to-market work, and increase revenue and profitability.",
  ogImage = '/og/home.jpg',
  ogImageAlt = "Stève Cattin, fractional CMO and GTM advisor – when growth gets complicated.",
  ogType = 'website',
  noIndex = false,
  publishedTime,
  modifiedTime,
  author = 'Stève Cattin',
} = Astro.props;

const site = Astro.site ?? 'https://stevecattin.com';
const canonical = new URL(Astro.url.pathname, site);
/* Scrapers won't resolve a relative path – og:image has to be absolute. */
const ogImageUrl = new URL(ogImage, site).toString();
const fullTitle = title.includes('Stève') ? title : `${title} – Stève Cattin`;

const toIso = (d?: Date | string) => (d ? new Date(d).toISOString() : undefined);
const isArticle = ogType === 'article';
const publishedIso = isArticle ? toIso(publishedTime) : undefined;
const modifiedIso = isArticle ? toIso(modifiedTime ?? publishedTime) : undefined;

const articleJsonLd = isArticle
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImageUrl,
      url: canonical.toString(),
      mainEntityOfPage: canonical.toString(),
      ...(publishedIso && { datePublished: publishedIso }),
      ...(modifiedIso && { dateModified: modifiedIso }),
      author: { '@type': 'Person', name: author, url: new URL('/about', site).toString() },
      publisher: { '@type': 'Person', name: 'Stève Cattin', url: site.toString() },
    })
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical.toString()} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stève Cattin" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {isArticle && <meta property="article:author" content={author} />}
    {publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {publishedIso && <meta name="publish_date" property="og:publish_date" content={publishedIso} />}
    {modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    {articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts: fully self-hosted (Cabinet Grotesk, General Sans, Switzer, JetBrains Mono) – no third-party CDN -->
    <link rel="preload" href="/fonts/CabinetGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title="Stève Cattin" href="/rss.xml" />

    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="JFQVPCKL" defer></script>
    <!-- / Fathom -->
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ContactModal />

    <script>
      // Drifting lights keep animating off screen unless told otherwise:
      // pause each light layer while it is out of view.
      const idle = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('is-idle', !e.isIntersecting)),
        { rootMargin: '120px 0px' },
      );
      document.querySelectorAll('.night-bg, .glow-stage').forEach((el) => idle.observe(el));
    </script>
  </body>
</html>
