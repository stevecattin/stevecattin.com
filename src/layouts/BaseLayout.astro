---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
}

const {
  title,
  description = "Fractional CMO, operator and sparring partner for founders, executives and their teams. We're all made of stories.",
  ogImage = '/og-default.png',
  ogImageAlt = "Stève Cattin – we're all made of stories.",
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? 'https://stevecattin.com';
const canonical = new URL(Astro.url.pathname, site);
/* Scrapers won't resolve a relative path – og:image has to be absolute. */
const ogImageUrl = new URL(ogImage, site).toString();
const fullTitle = title.includes('Stève') ? title : `${title} – Stève Cattin`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stève Cattin" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts: fully self-hosted (Cabinet Grotesk, General Sans, Switzer, JetBrains Mono) – no third-party CDN -->
    <link rel="preload" href="/fonts/CabinetGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title="Stève Cattin" href="/rss.xml" />

    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="JFQVPCKL" defer></script>
    <!-- / Fathom -->
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ContactModal />
  </body>
</html>
