---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    readingTime?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, pubDate, updatedDate, category, readingTime } = frontmatter;

const dateLabel = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post__header container">
      <p class="post__meta">
        <a href="/blog" class="post__back">← Writing</a>
      </p>

      <div class="post__badges">
        <span class="eyebrow">{category}</span>
        <span class="post__dot" aria-hidden="true"></span>
        <time datetime={pubDate.toISOString()} class="eyebrow">{dateLabel}</time>
        {readingTime && (
          <>
            <span class="post__dot" aria-hidden="true"></span>
            <span class="eyebrow">{readingTime}</span>
          </>
        )}
      </div>

      <h1 class="post__title">{title}</h1>
      <p class="post__lede">{description}</p>
    </header>

    <div class="container-prose post__body">
      <slot />
    </div>

    <footer class="container-prose post__footer">
      <svg class="post__signature" xmlns="http://www.w3.org/2000/svg" viewBox="73 53 783 302" aria-label="Stève" role="img">
