---
import BaseLayout from './BaseLayout.astro';
import GlowBackground from '../components/GlowBackground.astro';
import GlowRing from '../components/GlowRing.astro';
import NightLights from '../components/NightLights.astro';
import { getCollection } from 'astro:content';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    readingTime?: string;
  };
  /* Per-post social card, generated at build time by scripts/og/generate.mjs.
     Falls through to the site default when a post has no card yet. */
  ogImage?: string;
}

const { frontmatter, ogImage } = Astro.props;
const { title, description, pubDate, updatedDate, category, readingTime } = frontmatter;

// Keep reading: the two most recent other essays.
const next = (await getCollection('blog', ({ data }) => !data.draft && data.title !== title))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const dateLabel = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`${title} – an essay by Stève Cattin`}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <div class="glow-scope">
  <GlowBackground strength={0.3} dimTo={0.3} />

  <article class="post">
    <header class="post__header container">
      <p class="post__meta">
        <a href="/blog" class="post__back">← Writing</a>
      </p>

      <div class="post__badges">
        <span class="eyebrow">{category}</span>
        <span class="post__dot" aria-hidden="true"></span>
        <time datetime={pubDate.toISOString()} class="eyebrow">{dateLabel}</time>
        {readingTime && (
          <>
            <span class="post__dot" aria-hidden="true"></span>
            <span class="eyebrow">{readingTime}</span>
          </>
        )}
      </div>

      <h1 class="post__title">{title}</h1>
      <p class="post__lede">{description}</p>
    </header>

    <div class="container-prose post__body">
      <slot />
    </div>

  </article>
  </div>

  <!-- v3: every essay ends by fading into night – who wrote it, the one
       action, and what to read next. -->
  <footer class="post-end v3-night v3-night--end">
    <NightLights coral pale={false} />
    <div class="post-end__inner">
      <div class="post-end__sig">
        <GlowRing portrait size={96} sizeSm={80} />
        <div class="post-end__who">
          <p class="post-end__name">Written by Stève Cattin.</p>
          <p class="post-end__role">CMO &amp; GTM Advisor</p>
        </div>
        <button class="v3-btn post-end__cta" data-contact-trigger>Tell me your story →</button>
      </div>

      {next.length > 0 && (
        <>
          <p class="post-end__eyebrow">Keep reading</p>
          <ul class="v3-rows post-end__rows">
            {next.map((p) => (
              <li>
                <a href={`/blog/${p.slug}/`} class="v3-row">
                  <span class="v3-row__cat">{p.data.category}</span>
                  <span class="v3-row__title">{p.data.title}</span>
                  <span class="v3-row__meta">{p.data.readingTime?.replace(' read', '')}</span>
                  <span class="v3-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      <a href="/blog" class="v3-link post-end__all">All writing →</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .post {
    padding-top: calc(var(--space-16) + 40px);
  }

  .post__header {
    max-width: var(--max-w-prose);
    margin-bottom: var(--space-16);
  }

  .post__meta { margin-bottom: var(--space-10); }

  .post__back {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ash);
  }
  .post__back:hover { color: var(--color-cobalt); }

  .post__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .post__dot {
    width: 3px;
    height: 3px;
    background: var(--color-ash);
    border-radius: 50%;
  }

  /* v3: the homepage headline voice, a size down. */
  .post__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 1.5rem + 3.6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-6);
    max-width: 16ch;
    text-wrap: balance;
  }

  .post__lede {
    font-size: var(--text-lg);
    color: var(--color-graphite);
    line-height: var(--lh-normal);
    max-width: 58ch;
  }

  .post__body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: var(--tracking-tight);
  }

  .post__body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .post__body :global(p) {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    margin-bottom: var(--space-5);
    color: var(--color-ink);
  }

  .post__body :global(p + p) {
    margin-top: 0;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: var(--space-5) 0;
    padding-left: var(--space-6);
  }

  .post__body :global(li) {
    margin-bottom: var(--space-2);
    line-height: var(--lh-prose);
  }

  .post__body :global(blockquote) {
    border-left: 3px solid var(--color-cobalt);
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    margin: var(--space-6) 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-ink);
  }

  .post__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-mist);
    padding: 2px 5px;
    border-radius: var(--radius-sm);
  }

  .post__body :global(pre) {
    background: var(--color-mist);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .post__body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .post__body :global(a) {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: 0.95rem;
    font-family: var(--font-body);
  }

  .post__body :global(thead) {
    background: var(--color-mist);
  }

  .post__body :global(th) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    font-weight: 500;
    border-bottom: 1px solid var(--color-line);
  }

  .post__body :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 0.5px solid var(--color-line);
    line-height: var(--lh-snug);
    color: var(--color-ink);
    vertical-align: top;
  }

  .post__body :global(tbody tr:hover) {
    background: var(--color-cobalt-tint);
  }

  .post__body :global(hr) {
    border: 0;
    border-top: 0.5px solid var(--color-line);
    margin: var(--space-10) 0;
  }

  .post__body :global(figure.post__figure) {
    margin: var(--space-10) 0;
  }

  .post__body :global(figure.post__figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--color-line);
  }

  .post__body :global(figure.post__figure figcaption) {
    margin-top: var(--space-3);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: var(--text-base);
    line-height: var(--lh-snug);
    color: var(--color-graphite);
    text-align: center;
  }

  /* -------- The ending, on night (v3) -------- */
  .post-end {
    margin-top: var(--space-24);
    /* paper → night over the first 300px, then night to the end */
    background: linear-gradient(180deg,
      var(--color-paper) 0,
      var(--color-night-haze) 70px,
      var(--color-night-powder) 120px,
      var(--color-night-azure) 190px,
      var(--color-night-deep) 250px,
      var(--color-night) 300px);
    padding: 420px var(--space-6) var(--space-24);
  }
  .post-end > :global(.v3-lights) {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, transparent 260px, #000 420px);
            mask-image: linear-gradient(180deg, transparent 0, transparent 260px, #000 420px);
  }
  .post-end > :global(.v3-grain) {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, transparent 160px, #000 320px);
            mask-image: linear-gradient(180deg, transparent 0, transparent 160px, #000 320px);
  }
  .post-end__inner { max-width: 900px; margin: 0 auto; }

  .post-end__sig {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-bottom: var(--space-10);
  }
  .post-end__who { min-width: 0; }
  .post-end__name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-white);
  }
  .post-end__role { margin: 0; font-size: 15px; color: var(--color-night-powder); }
  .post-end__cta { margin-left: auto; }

  .post-end__eyebrow {
    margin: var(--space-6) 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-night-sky);
  }
  .post-end__rows { border-top: 1px solid rgba(196, 214, 240, 0.18); }
  .post-end__all { display: inline-block; margin-top: var(--space-7, 28px); }

  @media (max-width: 760px) {
    .post-end { padding-top: 360px; }
    .post-end__sig { flex-wrap: wrap; }
    .post-end__cta { margin-left: 0; }
  }
</style>
