---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    readingTime?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, pubDate, updatedDate, category, readingTime } = frontmatter;

const dateLabel = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post__header container">
      <p class="post__meta">
        <a href="/blog" class="post__back">← Writing</a>
      </p>

      <div class="post__badges">
        <span class="eyebrow">{category}</span>
        <span class="post__dot" aria-hidden="true"></span>
        <time datetime={pubDate.toISOString()} class="eyebrow">{dateLabel}</time>
        {readingTime && (
          <>
            <span class="post__dot" aria-hidden="true"></span>
            <span class="eyebrow">{readingTime}</span>
          </>
        )}
      </div>

      <h1 class="post__title">{title}</h1>
      <p class="post__lede">{description}</p>
    </header>

    <div class="container-prose post__body">
      <slot />
    </div>

    <footer class="container-prose post__footer">
      <hr class="rule" />
      <p class="post__sig">
        Written by Stève Cattin.
        <a href="mailto:hello@stevecattin.com?subject=Intro%20call">Reach out</a> or
        <a href="/blog">read more writing</a>.
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-16);
  }

  .post__header {
    max-width: var(--max-w-prose);
    margin-bottom: var(--space-16);
  }

  .post__meta { margin-bottom: var(--space-10); }

  .post__back {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ash);
  }
  .post__back:hover { color: var(--color-cobalt); }

  .post__badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .post__dot {
    width: 3px;
    height: 3px;
    background: var(--color-ash);
    border-radius: 50%;
  }

  .post__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-5);
    max-width: 22ch;
  }

  .post__lede {
    font-size: var(--text-lg);
    color: var(--color-graphite);
    line-height: var(--lh-normal);
    max-width: 58ch;
  }

  .post__body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    letter-spacing: var(--tracking-tight);
  }

  .post__body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .post__body :global(p) {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    margin-bottom: var(--space-5);
    color: var(--color-ink);
  }

  .post__body :global(p + p) {
    margin-top: 0;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: var(--space-5) 0;
    padding-left: var(--space-6);
  }

  .post__body :global(li) {
    margin-bottom: var(--space-2);
    line-height: var(--lh-prose);
  }

  .post__body :global(blockquote) {
    border-left: 3px solid var(--color-cobalt);
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    margin: var(--space-6) 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-ink);
  }

  .post__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-mist);
    padding: 2px 5px;
    border-radius: var(--radius-sm);
  }

  .post__body :global(pre) {
    background: var(--color-mist);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .post__body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .post__body :global(a) {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: 0.95rem;
    font-family: var(--font-body);
  }

  .post__body :global(thead) {
    background: var(--color-mist);
  }

  .post__body :global(th) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    font-weight: 500;
    border-bottom: 1px solid var(--color-line);
  }

  .post__body :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 0.5px solid var(--color-line);
    line-height: var(--lh-snug);
    color: var(--color-ink);
    vertical-align: top;
  }

  .post__body :global(tbody tr:hover) {
    background: var(--color-cobalt-tint);
  }

  .post__body :global(hr) {
    border: 0;
    border-top: 0.5px solid var(--color-line);
    margin: var(--space-10) 0;
  }

  .post__footer {
    margin-top: var(--space-16);
  }

  .post__sig {
    margin-top: var(--space-6);
    color: var(--color-graphite);
    font-size: var(--text-base);
  }
</style>
