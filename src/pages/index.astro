---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Stève Cattin – Fractional CEO, advisor, coach"
  description="The person your network sends you to when things get complicated. Twenty years operating inside scaled tech, two exits, and a belief that we're all made of stories."
>
  <section class="hero">
    <div class="hero__inner container-wide">
      <p class="eyebrow-pill">
        <span class="dot-mark" aria-hidden="true"></span>
        Fractional. Executive Advisor. Coaching.
      </p>

      <h1 class="hero__headline">
        We're all made of <em class="hero__accent">stories.</em>
      </h1>

      <p class="hero__sub">
        The person your network sends you to when things get complicated.
        Essays, frameworks, and the occasional strong opinion – alongside
        fractional executive, advisory, and coaching work for founders who want
        a sharp second brain in the room.
      </p>

      <div class="hero__cta-row">
        <a href="mailto:hello@stevecattin.com?subject=Intro%20call" class="hero__cta hero__cta--primary">
          Book a conversation →
        </a>
      </div>

      <div class="feed-preview">
        {recentPosts.map((post) => (
          <PostCard
            href={`/blog/${post.slug}/`}
            title={post.data.title}
            category={post.data.category}
            pubDate={post.data.pubDate}
            readingTime={post.data.readingTime}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------- Hero (the entire homepage in Direction 06) -------- */
  .hero {
    background: var(--color-paper);
    padding-block: clamp(80px, 8vw, 144px);
  }

  .eyebrow-pill {
    margin-bottom: var(--space-10);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-8);
    max-width: 820px;
  }

  .hero__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    color: var(--color-cobalt);
    font-variation-settings: "opsz" 144;
  }

  .hero__sub {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 600px;
    margin-bottom: var(--space-10);
  }

  .hero__cta-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-18);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
    font-size: 14px;
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }

  .hero__cta--primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .hero__cta--primary:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--color-cobalt);
    border: 1px solid var(--color-cobalt);
  }
  .hero__cta--secondary:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  /* -------- Post feed preview -------- */
  .feed-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 0.5px solid var(--color-line);
  }

  @media (max-width: 960px) {
    .feed-preview { grid-template-columns: 1fr; }
  }
</style>
