---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Stève Cattin – Fractional Executive, Advisor, Sparring Partner"
  description="Fractional executive, advisor and sparring partner for founders, executives and their teams. When something's stuck, it's usually the space and the stories between them."
>
  <section class="hero">
    <div class="hero__inner container-wide">
      <div class="hero__lede">
        <div class="hero__copy">
          <p class="eyebrow-pill">
            <span class="dot-mark" aria-hidden="true"></span>
            Fractional Executive. Advisor. Sparring Partner.
          </p>

          <h1 class="hero__headline">
            We're all made of <em class="hero__accent">stories.</em>
          </h1>

          <p class="hero__sub">
            Hi, I'm Stève! I work with founders, execs and their teams when things get complicated. Twenty years across GTM, Ops and People – fifteen of them in B2B Tech, two acquisitions in – here's what I've learned: when something isn't working, it's rarely just the plan or just the team. It's usually the space, and the stories, between them.
          </p>

          <div class="hero__cta-row">
            <button class="hero__cta hero__cta--primary" data-contact-trigger>
              Let's chat →
            </button>
            <a href="/practice" class="hero__cta hero__cta--secondary">
              Work with me →
            </a>
          </div>
        </div>

        <figure class="hero__portrait">
          <img
            src="/portrait.png"
            alt="Portrait of Stève Cattin"
            width="1792"
            height="2390"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>

      <section class="recent" aria-labelledby="recent-title">
        <header class="recent__head">
          <h2 id="recent-title" class="recent__title">Recent thinking</h2>

          <p class="recent__sub">Essays, frameworks, and the occasional strong opinion.</p>
        </header>

        <div class="feed-preview">
          {recentPosts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}/`}
              title={post.data.title}
              category={post.data.category}
              pubDate={post.data.pubDate}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>
      </section>
    </div>
  </section>

  <section class="framework" aria-labelledby="framework-title">
    <div class="container-wide framework__inner">
      <p class="framework__eyebrow">The framework I built</p>
      <h2 id="framework-title" class="framework__title">
        The AI Marketing Ascendancy Framework.
      </h2>
      <p class="framework__lede">
        My framework for moving marketing teams from AI-curious to
        AI-confident – across people, processes, and technology.
      </p>
      <a href="/blog/the-ai-marketing-ascendancy-framework/" class="framework__cta">
        Read the framework <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------- Hero (the entire homepage in Direction 06) -------- */
  .hero {
    background: var(--color-paper);
    padding-top: clamp(48px, 5vw, 96px);
    padding-bottom: clamp(80px, 8vw, 144px);
  }

  /* Asymmetric two-column lede: copy on the left, portrait on the right.
     Portrait is anchored to the hairline below; text floats centered in
     the row so it sits balanced between nav and hairline, with breathing
     room above the eyebrow and below the CTA. The min-height guarantees
     enough vertical space for that breathing room at any container width. */
  .hero__lede {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    min-height: clamp(560px, 55vh, 680px);
    margin-bottom: 0;
  }

  .hero__copy {
    /* keep the existing copy block intact; just lets the portrait sit beside it */
    min-width: 0;
    align-self: center;
  }

  .hero__portrait {
    margin: 0;
    aspect-ratio: 3 / 4;
    max-width: 460px;
    justify-self: end;
    align-self: end;
    width: 100%;
  }

  .hero__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    /* Two stacked drop-shadows that follow the silhouette via the PNG's
       alpha channel – re-creates the "photographed against a wall" cast
       shadow without bringing the wall rectangle back. Warm-gray tone
       sits more naturally on warm paper than pure black. */
    filter:
      drop-shadow(0 3px 8px rgba(40, 35, 30, 0.10))
      drop-shadow(8px 16px 36px rgba(40, 35, 30, 0.14));
  }

  /* Mobile: copy stacks on top, portrait below it, grounded on the .recent
     hairline – same visual logic as desktop, just collapsed into one column.
     Centered (rather than right-aligned) because there's no asymmetric grid
     to justify against once we're single-column. */
  @media (max-width: 760px) {
    .hero__lede {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      min-height: 0;     /* let content set the height; no desktop min */
      margin-bottom: 0;  /* portrait sits flush on the .recent hairline */
    }

    .hero__portrait {
      justify-self: center;
      align-self: end;
      max-width: 280px;
    }

    /* CTAs stack vertically and stretch full-width on mobile – easier tap
       targets and a cleaner rhythm above the portrait. */
    .hero__cta-row {
      flex-direction: column;
    }

    .hero__cta {
      justify-content: center;
    }
  }

  /* Reset the hero__cta-row bottom margin – the lede grid handles spacing now. */
  .hero__lede .hero__cta-row {
    margin-bottom: 0;
  }

  .eyebrow-pill {
    margin-bottom: var(--space-10);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-8);
    max-width: 820px;
  }

  .hero__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    color: var(--color-cobalt);
    font-variation-settings: "opsz" 144;
  }

  .hero__sub {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 600px;
    margin-bottom: var(--space-10);
  }

  .hero__cta-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-18);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
    font-size: 14px;
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }

  .hero__cta--primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .hero__cta--primary:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--color-cobalt);
    border: 1px solid var(--color-cobalt);
  }
  .hero__cta--secondary:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  /* -------- Recent writings section -------- */
  .recent {
    /* Hairline lives here now: divides the hero from the writings section.
       Portrait grounds on this line above. */
    border-top: 0.5px solid var(--color-line);
    padding-top: clamp(40px, 4vw, 64px);
  }

  .recent__head {
    margin-bottom: var(--space-8);
    max-width: 720px;
  }

  .recent__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-2xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-2);
  }

  .recent__sub {
    font-size: var(--text-base);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    margin: 0;
  }

  /* -------- Post feed preview -------- */
  .feed-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 960px) {
    .feed-preview { grid-template-columns: 1fr; }
  }

  /* -------- Framework section (mist, editorial) -------- */
  /* Full-bleed mist block, hairline above. Echoes the About pullquote's
     editorial weight – this is "durable IP," not a feed item. No card
     chrome: the surface itself carries the section break, type does the
     rest. Container-wide centers the inner column. */
  .framework {
    background: var(--color-mist);
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-20);
  }

  .framework__inner {
    max-width: 920px;
  }

  .framework__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin: 0 0 var(--space-5);
  }

  .framework__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-3xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
    max-width: 22ch;
  }

  .framework__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 56ch;
    margin: 0 0 var(--space-8);
  }

  .framework__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .framework__cta:hover {
    color: var(--color-cobalt-deep);
  }

  .framework__cta:hover .arrow {
    transform: translateX(4px);
  }

  .framework__cta .arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (max-width: 640px) {
    .framework { padding-block: var(--space-16); }
  }
</style>
