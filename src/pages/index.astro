---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import CTABlock from '../components/CTABlock.astro';
import GlowBackground from '../components/GlowBackground.astro';
import AimaCone from '../components/AimaCone.astro';
import GlowRing from '../components/GlowRing.astro';
import NightLights from '../components/NightLights.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// The three most recent published posts, newest first.
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// The four moments – short versions of the "When to work with me" list on
// /practice (full text lives there; keep the titles in sync).
const moments = [
  {
    title: 'Grown by instinct. Now, by design.',
    body: "Your marketing and GTM grew organically – which works, until it breaks. To scale, you need a system, and a team built to run it. I'll get you there.",
  },
  {
    title: 'Growth has stalled, and no one can say why.',
    body: "Let's investigate and dig into market dynamics, numbers, channels, systems, the team, and establish the strategy that will bring growth back.",
  },
  {
    title: "Something new on the horizon.",
    body: "A new product, a new segment or a pivot? Or a new region – Europe to the US, or the other way around? We define the best marketing and GTM strategy to make it a success and avoid costly mistakes.",
  },
  {
    title: "A big event is happening.",
    body: "A raise, an exit, a restructuring, or simply a team that needs a second wind. You need someone who's been through <em>it</em> and can transform with you – keeping the team's energy up, and pointed at what matters.",
  },
];

// AIMA at a glance: the five stages (the pillars are named in the copy).
---

<BaseLayout
  title="Stève Cattin • Growth by design, not instinct"
  description="I partner with founders, execs and their teams to make their marketing and go-to-market work, and increase revenue and profitability."
>
  <!-- v3 "Dusk to night": the hero runs from paper to night, "When to work
       with me" sits in the night and fades back to paper; the moving light
       (GlowBackground) takes over from the testimonials down. -->
  <section class="hero v3-dusk">
    <NightLights pale={false} />
    <div class="hero__inner container-wide">
      <div class="hero__lede">
        <div class="hero__copy">
          <h1 class="hero__headline">
            When growth gets <span class="hero__accent">complicated</span>
          </h1>

          <p class="hero__sub">I partner with founders, execs and their teams to make their marketing and go-to-market work, and increase revenue and profitability.</p>

          <div class="hero__cta-row">
            <button class="v3-btn" data-contact-trigger>
              Tell me your story →
            </button>
            <a href="#when" class="v3-link hero__link">When to work with me</a>
          </div>
        </div>

        <figure class="hero__portrait">
          <GlowRing portrait size={360} sizeSm={240} />
        </figure>
      </div>
    </div>
  </section>

  <section id="when" class="moments v3-night" aria-labelledby="moments-title">
    <NightLights />
    <div class="container-wide">
      <h2 id="moments-title" class="moments__title">
        When to work with <span class="accent">me</span>
      </h2>
      <p class="moments__intro">I take care of the strategy, the system, the goals and of what no spreadsheet captures: how people feel, the culture, and the things left unsaid.</p>

      <ul class="moments__list">
        {moments.map((m) => (
          <li class="moments__item">
            <h3 class="moments__item-title">{m.title}</h3>
            <p class="moments__item-body" set:html={m.body} />
          </li>
        ))}
      </ul>

      <div class="moments__foot">
        <p class="moments__aside">Investor with a portfolio company in one of these moments? Same conversation.</p>
      </div>
    </div>
  </section>

  <!-- The moving light stays behind the content from here down to the
       closing night band, then scrolls away with it. -->
  <div class="glow-scope glow-scope--below">
  <GlowBackground strength={0.4} />

  <Testimonials
    featuredId="karen-clarke"
    rowIds={["kristin-johnsen", "christina-nahal", "berin-sadikovic"]}
    eyebrow=""
    title=""
    lead
  />

  <section class="framework" aria-labelledby="framework-title">
    <div class="container-wide framework__inner">
      <div class="framework__copy">
        <h2 id="framework-title" class="section-title">
          The AI Marketing Ascendancy Framework.
        </h2>
        <p class="framework__lede">
          I built my own framework to move Marketing teams from AI-curious to
          AI-confident, across people, processes and technology.
        </p>
        <a href="/aima" class="text-link">Explore the framework →</a>
      </div>

      <div class="framework__cone">
        <AimaCone uid="home-cone" mode="scroll" />
      </div>
    </div>
  </section>

  <section class="writing" aria-labelledby="writing-title">
    <div class="container-wide">
      <h2 id="writing-title" class="section-title">
        My notes from the field, and the occasional strong opinion.
      </h2>

      <ul class="writing__list">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="writing__row">
              <span class="writing__cat">{post.data.category}</span>
              <span class="writing__title">{post.data.title}</span>
              <span class="writing__meta">
                {formatDate(post.data.pubDate)}{post.data.readingTime && ` · ${post.data.readingTime}`}
              </span>
              <span class="writing__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <a href="/blog" class="text-link writing__all">All writing →</a>
    </div>
  </section>

  <CTABlock
    wide
    night
    eyebrow=""
    headline="Everything starts with a story."
    body="A simple first chat: you tell me what's happening, I listen and share what I see."
    ctaLabel="Tell me your story →"
    ctaModal
  />
  </div>
</BaseLayout>


<style>
  /* -------- Hero: dusk (v3) -------- */
  .hero {
    --s: 41%;
    min-height: 800px;
    padding-top: calc(var(--nav-h) + 160px);
    padding-bottom: 150px;
    box-sizing: border-box;
  }

  /* Copy on the left, the glowing portrait ring on the right. */
  .hero__lede {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero__copy { min-width: 0; }

  .hero__portrait {
    margin: 0;
    justify-self: center;
    padding-top: 10px;
  }

  /* The headline opens the page; the name and role sit in the nav.
     8.6em at 96px = 820px, so it breaks after "gets". */
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 6.6vw, 96px);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    margin: 0;
    max-width: 8.6em;
  }

  .hero__accent { color: var(--color-cobalt); }

  .hero__sub {
    margin: 36px 0 0;
    max-width: 520px;
    font-size: 19px;
    font-weight: 500;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    text-wrap: pretty; /* no one-word last lines */
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    gap: var(--space-7, 28px);
    flex-wrap: wrap;
    margin-top: 40px;
  }

  @media (max-width: 760px) {
    .hero {
      --s: 52%;
      min-height: 0;
      padding-top: calc(var(--nav-h) + 72px);
      padding-bottom: 96px;
    }
    .hero__lede {
      grid-template-columns: 1fr;
      gap: 72px;
    }
    /* On phones the second link still sits on paper: ink, not white. */
    .hero__link {
      color: var(--color-ink);
      border-bottom-color: color-mix(in srgb, var(--color-ink) 40%, transparent);
    }
  }

  /* -------- Shared section type -------- */
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin: 0 0 var(--space-4);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }

  .text-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-cobalt);
  }
  .text-link:hover { color: var(--color-ink); }

  /* Touch screens: the text links get an invisible 12px above and below,
     so they're a comfortable tap (~44px) without moving anything – the
     negative margin cancels the padding in the layout. */
  @media (pointer: coarse) {
    .hero__link,
    .text-link {
      padding-block: var(--space-3);
      margin-block: calc(-1 * var(--space-3));
    }
  }

  /* -------- When to work with me: on night (v3) -------- */
  .moments {
    padding-block: 75px calc(var(--dawn) + 60px);
    scroll-margin-top: 0;
  }

  .moments__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    color: var(--color-white);
    margin: 0 0 28px;
    max-width: 18ch;
    text-wrap: balance;
  }

  .moments__intro {
    margin: 0 0 var(--space-16);
    max-width: 640px;
    font-size: 20px;
    line-height: var(--lh-normal);
    color: var(--color-night-powder);
    text-wrap: pretty;
  }

  .accent { color: var(--color-cobalt); }
  .moments .accent { color: var(--color-night-sky); }

  .moments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-10);
    row-gap: var(--space-12);
  }

  /* Editorial columns: no cards, no numbers, no rules – type only. */
  .moments__item-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-white);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }

  .moments__item-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-night-powder);
    margin: 0;
  }

  .moments__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-12);
  }

  .moments__aside {
    font-size: 16px;
    color: var(--color-night-powder);
    margin: 0;
  }

  @media (max-width: 1100px) {
    .moments__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .moments { padding-block: var(--space-16) calc(var(--dawn) + 40px); --dawn: 260px; }
    .moments__list { grid-template-columns: 1fr; row-gap: var(--space-10); }
    .moments__item-title { font-size: 24px; }
  }

  /* -------- Framework: copy + AIMA at a glance -------- */
  .framework {
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-24);
  }

  .framework__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .framework__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 48ch;
    margin: 0 0 var(--space-8);
  }

  /* The cone itself lives in AimaCone.astro. */
  .framework__cone {
    width: 100%;
    max-width: 580px;
    justify-self: center;
  }

  @media (max-width: 960px) {
    .framework__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .framework { padding-block: var(--space-16); }
  }

  /* -------- Selected writing: a typographic list -------- */
  .writing {
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-24) var(--space-8);
  }

  .writing__list {
    list-style: none;
    margin: var(--space-10) 0 var(--space-8);
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .writing__row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto 24px;
    align-items: baseline;
    gap: var(--space-6);
    padding-block: var(--space-7, 28px);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .writing__cat,
  .writing__meta {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .writing__cat { color: var(--color-cobalt); }
  .writing__meta { color: var(--color-ash); white-space: nowrap; }

  .writing__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .writing__arrow {
    font-size: 20px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .writing__row:hover .writing__title { color: var(--color-cobalt); }
  .writing__row:hover .writing__arrow { transform: translateX(4px); }

  @media (max-width: 760px) {
    .writing { padding-block: var(--space-16) var(--space-4); }
    .writing__row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "cat arrow" "title title" "meta meta";
      row-gap: var(--space-2);
    }
    .writing__cat { grid-area: cat; }
    .writing__title { grid-area: title; }
    .writing__meta { grid-area: meta; }
    .writing__arrow { grid-area: arrow; }
  }
</style>
