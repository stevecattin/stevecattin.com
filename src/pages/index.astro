---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import CTABlock from '../components/CTABlock.astro';
import GlowBackground from '../components/GlowBackground.astro';
import AimaCone from '../components/AimaCone.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Hand-picked for the homepage, in this order: the offer, how I run teams,
// the personal one. Change the slugs here to re-curate. A slug that is missing
// or set to draft simply drops out, so keep these three published.
const featuredSlugs = [
  'you-dont-need-an-agency-yet',
  'rebuilding-the-5-15',
  'a-long-table-in-the-south',
];
const bySlug = new Map(allPosts.map((post) => [post.slug, post]));
const featuredPosts = featuredSlugs
  .map((slug) => bySlug.get(slug))
  .filter((post): post is CollectionEntry<'blog'> => post !== undefined);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// The four moments – short versions of the "When to work with me" list on
// /practice (full text lives there; keep the titles in sync).
const moments = [
  {
    title: 'Your go-to-market grew by instinct. Now it has to grow by design.',
    body: "A round just closed, or a new CEO arrived. It's time to scale. We work out what to build, what to buy, and what to stop paying for.",
  },
  {
    title: 'Growth has stalled, and no one can say why.',
    body: "Let's investigate and dig into market dynamics, numbers, channels, systems, the team, and establish the strategy that will bring growth back.",
  },
  {
    title: "Something new on the horizon.",
    body: "A new country, product or segment? We define the best GTM strategy to make it a success and avoid costly mistakes.",
  },
  {
    title: "A big event is happening.",
    body: "A raise, an exit, a restructuring. You need someone who's been through it and can transform with you while keeping the team engaged.",
  },
];

// AIMA at a glance: the five stages (the pillars are named in the copy).
---

<BaseLayout
  title="Stève Cattin – Fractional CMO, Advisor, Sparring Partner"
  description="Fractional CMO, advisor and sparring partner for founders, executives and their teams. When something's stuck, it's usually the space and the stories between them."
>
  <!-- The moving light sits in a sticky, viewport-tall layer that stays
       behind the content from the hero down to the closing night band,
       then scrolls away with it. Sections inside are transparent. -->
  <div class="glow-scope">
  <GlowBackground strength={0.4} />

  <section class="hero hero--glow">
    <div class="hero__inner container-wide">
      <div class="hero__lede">
        <div class="hero__copy">
          <p class="hero__greeting">Hi, I'm <span class="hero__name">Stève.</span></p>

          <h1 class="hero__headline">
            When growth gets <span class="hero__accent">complicated</span>
          </h1>

          <div class="hero__sub">
            <p>I partner with founders, execs and their teams to make their marketing and go-to-market work, and increase revenue and profitability.</p>
            <p>I take care of the strategy, the system, the goals and of what no spreadsheet captures: how people feel, the culture, and the things left unsaid.</p>
          </div>

          <div class="hero__cta-row">
            <button class="hero__cta" data-contact-trigger>
              Tell me your story →
            </button>
            <a href="#when" class="hero__link">When to work with me</a>
          </div>
        </div>

        <figure class="hero__portrait" data-glow-focus>
          <img
            src="/portrait-popout.webp"
            alt="Portrait of Stève Cattin"
            width="720"
            height="859"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="when" class="moments" aria-labelledby="moments-title">
    <div class="container-wide">
      <p class="section-eyebrow">When to work with me</p>
      <h2 id="moments-title" class="moments__title">
        Companies scale faster than the way they're <span class="accent">run.</span>
      </h2>

      <ol class="moments__list">
        {moments.map((m, i) => (
          <li class="moments__item">
            <span class="moments__num">№ {String(i + 1).padStart(2, '0')}</span>
            <h3 class="moments__item-title">{m.title}</h3>
            <p class="moments__item-body">{m.body}</p>
          </li>
        ))}
      </ol>

      <div class="moments__foot">
        <p class="moments__aside">Investor with a portfolio company in one of these moments? Same conversation.</p>
        <a href="/practice#when" class="text-link">The full picture on Work with me →</a>
      </div>
    </div>
  </section>

  <Testimonials
    featuredId="karen-clarke"
    rowIds={["kristin-johnsen", "christina-nahal", "berin-sadikovic"]}
    title=""
    lead
  />

  <section class="framework" aria-labelledby="framework-title">
    <div class="container-wide framework__inner">
      <div class="framework__copy">
        <p class="section-eyebrow">The framework I built</p>
        <h2 id="framework-title" class="section-title">
          The AI Marketing Ascendancy Framework.
        </h2>
        <p class="framework__lede">
          Achieving AI marketing ascendancy across people, processes, and
          technology – five stages, from AI-curious to AI-confident. I meet your
          team where it is, and take it where it needs to be.
        </p>
        <a href="/aima" class="text-link">Explore the framework →</a>
      </div>

      <div class="framework__cone">
        <AimaCone uid="home-cone" />
      </div>
    </div>
  </section>

  <section class="writing" aria-labelledby="writing-title">
    <div class="container-wide">
      <p class="section-eyebrow">Selected writing</p>
      <h2 id="writing-title" class="section-title">
        Essays, field notes, and the occasional strong opinion.
      </h2>

      <ul class="writing__list">
        {featuredPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="writing__row">
              <span class="writing__cat">{post.data.category}</span>
              <span class="writing__title">{post.data.title}</span>
              <span class="writing__meta">
                {formatDate(post.data.pubDate)}{post.data.readingTime && ` · ${post.data.readingTime}`}
              </span>
              <span class="writing__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <a href="/blog" class="text-link writing__all">All writing →</a>
    </div>
  </section>

  <CTABlock
    wide
    night
    eyebrow="Where we start"
    headline="Something stuck? Start with the story."
    body="Tell me what's happening. We'll figure out together where to begin."
    ctaLabel="Tell me your story →"
    ctaModal
    secondaryLabel="When to work with me →"
    secondaryHref="/practice#when"
  />
  </div>
</BaseLayout>


<style>
  /* -------- Hero -------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: transparent;
    padding-top: clamp(48px, 5vw, 96px);
    padding-bottom: var(--space-20);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* The name stays ink – "complicated." is the hero's one accent word. */
  .hero__name {
    color: inherit;
  }

  /* Asymmetric two-column lede: copy on the left, portrait on the right. */
  .hero__lede {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }

  .hero__copy {
    min-width: 0;
    align-self: center;
  }

  /* Round, CV-style portrait: head breaks out of the top of a mist disc.
     Disc and pop-out are baked into the image; the transparent master
     cutout lives in assets-source/Portrait_Cutout.png. Centred in its
     column so it sits closer to the copy; the big blue light starts behind
     it (data-glow-focus, see GlowBackground). */
  .hero__portrait {
    margin: 0;
    width: 100%;
    max-width: 360px;
    justify-self: center;
    align-self: center;
  }

  .hero__portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__greeting {
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-6);
  }

  /* The promise leads; the greeting introduces it. */
  .hero__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 6.6vw, 100px);
    line-height: 0.98;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-ink);
    margin: 0 0 var(--space-8);
    max-width: 11.5em;
    text-wrap: balance;
  }

  .hero__accent {
    color: var(--color-cobalt);
  }

  .hero__sub {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 600px;
    margin: 0 0 var(--space-10);
  }

  /* Two short beats – what it's for, then how – with a tight gap so they
     still read as one thought. */
  .hero__sub p {
    margin: 0;
    line-height: inherit;
    text-wrap: pretty; /* no one-word last lines */
  }
  .hero__sub p + p {
    margin-top: var(--space-4);
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    gap: var(--space-7, 28px);
    flex-wrap: wrap;
  }

  /* One button. The secondary path is a quiet text link. */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    font-size: 15px;
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.01em;
    background: var(--color-cobalt);
    color: var(--color-white);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .hero__cta:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .hero__link:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-cobalt);
  }

  @media (max-width: 760px) {
    .hero__lede {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .hero__portrait {
      justify-self: center;
      max-width: 240px;
    }
  }

  /* -------- Shared section type -------- */
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin: 0 0 var(--space-4);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }

  .text-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-cobalt);
  }
  .text-link:hover { color: var(--color-ink); }

  /* -------- When to work with me: thesis + the four moments -------- */
  .moments {
    padding-block: var(--space-20) var(--space-24);
    scroll-margin-top: 64px;
  }

  .moments__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-16);
    max-width: 18ch;
    text-wrap: balance;
  }

  .accent { color: var(--color-cobalt); }

  .moments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .moments__item {
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-6);
  }

  .moments__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    margin-bottom: var(--space-4);
  }

  .moments__item-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-3);
  }

  .moments__item-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
  }

  .moments__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-12);
  }

  .moments__aside {
    font-size: 16px;
    color: var(--color-graphite);
    margin: 0;
  }

  @media (max-width: 1100px) {
    .moments__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-10); }
  }
  @media (max-width: 640px) {
    .moments { padding-block: var(--space-16); }
    .moments__list { grid-template-columns: 1fr; }
  }

  /* -------- Framework: copy + AIMA at a glance -------- */
  .framework {
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-24);
  }

  .framework__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .framework__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 48ch;
    margin: 0 0 var(--space-8);
  }

  /* The cone itself lives in AimaCone.astro. */
  .framework__cone {
    width: 100%;
    max-width: 580px;
    justify-self: center;
  }

  @media (max-width: 960px) {
    .framework__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .framework { padding-block: var(--space-16); }
  }

  /* -------- Selected writing: a typographic list -------- */
  .writing {
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-24) var(--space-8);
  }

  .writing__list {
    list-style: none;
    margin: var(--space-10) 0 var(--space-8);
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .writing__row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto 24px;
    align-items: baseline;
    gap: var(--space-6);
    padding-block: var(--space-7, 28px);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .writing__cat,
  .writing__meta {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .writing__cat { color: var(--color-cobalt); }
  .writing__meta { color: var(--color-ash); white-space: nowrap; }

  .writing__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .writing__arrow {
    font-size: 20px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .writing__row:hover .writing__title { color: var(--color-cobalt); }
  .writing__row:hover .writing__arrow { transform: translateX(4px); }

  @media (max-width: 760px) {
    .writing { padding-block: var(--space-16) var(--space-4); }
    .writing__row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "cat arrow" "title title" "meta meta";
      row-gap: var(--space-2);
    }
    .writing__cat { grid-area: cat; }
    .writing__title { grid-area: title; }
    .writing__meta { grid-area: meta; }
    .writing__arrow { grid-area: arrow; }
  }
</style>
