---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import FeaturedPostCard from '../../components/FeaturedPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout
  title="Writing – Stève Cattin"
  description="Essays on leadership, brand, founding, and the quieter seasons in between."
>
  <section class="blog-hero container">
    <p class="eyebrow">Writing</p>
    <h1 class="blog-hero__title">
      Notes from the work.
    </h1>
    <p class="blog-hero__lede">
      Essays on leadership, brand, founding, and the quieter seasons in
      between. Published when I have something honest to say, not on a
      schedule.
    </p>

    <ul class="blog-hero__tags">
      <li class="eyebrow is-active">All</li>
      {categories.map((c) => (
        <li class="eyebrow">{c}</li>
      ))}
    </ul>
  </section>

  <section class="container blog-list section-tight">
    {featured && (
      <FeaturedPostCard
        href={`/blog/${featured.slug}/`}
        title={featured.data.title}
        description={featured.data.description}
        category={featured.data.category}
        pubDate={featured.data.pubDate}
        readingTime={featured.data.readingTime}
      />
    )}

    <div class="blog-grid">
      {rest.map((post, i) => (
        <PostCard
          href={`/blog/${post.slug}/`}
          title={post.data.title}
          category={post.data.category}
          pubDate={post.data.pubDate}
          readingTime={post.data.readingTime}
          wide={i % 5 === 3}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    padding-block: clamp(4rem, 4vw + 3rem, 7rem);
    max-width: 900px;
  }

  .blog-hero .eyebrow {
    margin-bottom: var(--space-5);
  }

  .blog-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-5);
    max-width: 18ch;
  }

  .blog-hero__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .blog-hero__tags {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .blog-hero__tags li {
    padding: 6px 10px;
    border: 0.5px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-graphite);
  }

  .blog-hero__tags li.is-active {
    border-color: var(--color-cobalt);
    color: var(--color-cobalt);
    background: var(--color-cobalt-tint);
  }

  .blog-list {
    padding-top: var(--space-8);
    border-top: 0.5px solid var(--color-line);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 960px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>
