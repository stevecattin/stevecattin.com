---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import FeaturedPostCard from '../../components/FeaturedPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.filter((p) => p.slug !== featured.slug);
// Derived from posts – new categories appear automatically when used
const categories = ['Leadership', 'Marketing', 'Founding', 'Personal'].filter(
  (c) => posts.some((p) => p.data.category === c)
);
---

<BaseLayout
  title="Writing – Stève Cattin"
  description="Essays on leadership, brand, founding, and the quieter seasons in between."
>
  <section class="blog-hero container">
    <p class="eyebrow">Writing</p>
    <h1 class="blog-hero__title">
      Notes from the work.
    </h1>
    <p class="blog-hero__lede">
      Essays on leadership, marketing, and the occasional personal piece.
      Published when I have something honest to say, not on a schedule.
    </p>

    <ul class="blog-hero__tags" id="category-filters">
      <li>
        <button class="eyebrow filter-btn is-active" data-filter="all">All</button>
      </li>
      {categories.map((c) => (
        <li>
          <button class="eyebrow filter-btn" data-filter={c}>{c}</button>
        </li>
      ))}
    </ul>
  </section>

  <section class="container blog-list section-tight">
    {featured && (
      <div data-post-category={featured.data.category}>
        <FeaturedPostCard
          href={`/blog/${featured.slug}/`}
          title={featured.data.title}
          description={featured.data.description}
          category={featured.data.category}
          pubDate={featured.data.pubDate}
          readingTime={featured.data.readingTime}
        />
      </div>
    )}

    <div class="blog-grid">
      {rest.map((post, i) => (
        <div data-post-category={post.data.category} class:list={[{ 'col-span-2': i % 5 === 3 }]}>
          <PostCard
            href={`/blog/${post.slug}/`}
            title={post.data.title}
            category={post.data.category}
            pubDate={post.data.pubDate}
            readingTime={post.data.readingTime}
            wide={i % 5 === 3}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const postItems = document.querySelectorAll<HTMLElement>('[data-post-category]');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      // Update active button
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      // Show / hide posts
      postItems.forEach((item) => {
        const match = filter === 'all' || item.dataset.postCategory === filter;
        item.style.display = match ? '' : 'none';
      });
    });
  });
</script>

<style>
  .blog-hero {
    padding-block: clamp(4rem, 4vw + 3rem, 7rem);
    max-width: 900px;
  }

  .blog-hero .eyebrow {
    margin-bottom: var(--space-5);
  }

  .blog-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-5);
    max-width: 18ch;
  }

  .blog-hero__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .blog-hero__tags {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 6px 10px;
    border: 0.5px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-graphite);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out);
  }

  .filter-btn:hover {
    border-color: var(--color-cobalt);
    color: var(--color-cobalt);
  }

  .filter-btn.is-active {
    border-color: var(--color-cobalt);
    color: var(--color-cobalt);
    background: var(--color-cobalt-tint);
  }

  .blog-list {
    padding-top: var(--space-8);
    border-top: 0.5px solid var(--color-line);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .blog-grid .col-span-2 {
    grid-column: span 2;
  }

  @media (max-width: 960px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .blog-grid { grid-template-columns: 1fr; }
    .blog-grid .col-span-2 { grid-column: span 1; }
  }
</style>
