---
import { existsSync } from 'node:fs';
import { getCollection, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

/* Cards are written to public/og/<slug>.png by the prebuild step. Checking
   for the file keeps a post from advertising an image that isn't there –
   it quietly falls back to the site default instead. */
const cardPath = `/og/${post.slug}.png`;
const ogImage = existsSync(new URL(`../../../public${cardPath}`, import.meta.url))
  ? cardPath
  : undefined;
---

<PostLayout frontmatter={post.data} ogImage={ogImage}>
  <Content />
</PostLayout>
