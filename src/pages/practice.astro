---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import GlowBackground from '../components/GlowBackground.astro';
import Testimonials from '../components/Testimonials.astro';

const moments = [
  {
    title: "Your go-to-market grew by instinct. Now it has to grow by design.",
    body: "A hire here, a tool there, an agency no one quite knows how to brief. It worked… until it didn't anymore. A round just closed, a first senior hire didn't land, or a new CEO arrived and is asking what has actually been built and how to scale and grow. Before you invest in the next stage, we work out what to build, what to buy, and what to stop paying for.",
  },
  {
    title: "Growth has stalled, and no one can say why.",
    body: "The funnel is shrinking. Targets get missed, quarter after quarter. Your revenue leaders are working harder than ever, and still, friction between teams slows everything down. It's rarely just a broken funnel. More often, it's a team fighting a system it has outgrown. I look at both.",
  },
  {
    title: "Something new on the horizon.",
    body: "A new country – Europe to North America, say. A new product, or a new segment. Or it's already out there, and it's harder than the plan said. We work out where it's likely to break – the story, the team, the way you sell – and fix that first.",
  },
  {
    title: "A big event is happening.",
    body: "A raise, an exit, a restructuring. The board wants a serious plan. The team needs someone who has been through it before, knows what it feels like, and can hold everything together. That's the seat I take: alongside the CEO, in front of investors, and with the team.",
  },
];

const modes = [
  {
    glyph: 'seat',
    meta: 'In the seat · 1–3 days a week',
    title: 'Fractional executive.',
    body: 'One to three days a week, in the seat. I usually come in on the function that\'s most exposed – for a company scaling past its structure, that\'s typically marketing or GTM. But it rarely stays in one box. I\'ve run People and Operations too, and sat on the executive team – so I hire who needs hiring, decide what needs deciding, free you to focus on what only you can do, and I\'m in the room for what fits no single function: vision, product, the calls only the leadership team can make.',
    fit: 'Right for you if you need someone who can hold a function and think about the whole company alongside you.',
  },
  {
    glyph: 'beside',
    meta: 'Outside the org chart · A regular cadence',
    title: 'Advisory.',
    body: 'A regular cadence outside the org chart. For founders and execs who already have a team and a plan, and want a senior operator to think with – about the next quarter\'s bets, the leadership decisions that don\'t have an obvious right answer, the conversations you\'d rather not have alone. I\'m not in the day-to-day, but close enough to the work to be useful.',
    fit: 'Right for you if the team is in place and what you need is a trusted person to pressure-test the plan.',
  },
  {
    glyph: 'one',
    meta: 'One to one · Off the record',
    title: 'Sparring, privately.',
    body: 'For leaders who sense the hardest problem they\'re carrying is the one inside themselves. A room with no audience and no agenda – confidential, off the org chart, off the record. Just the time to think it through with someone who has been in your seat, and seen this kind of problem up close, more than once.',
    fit: 'Right for you if what\'s getting in the way isn\'t the company – it\'s you, and you want someone to think it through with.',
  },
];

// Why me – what I bring to the room. The depth lives on About.
const reasons = [
  {
    title: 'The whole engine, not just marketing.',
    body: 'I\'ve built marketing inside scaling companies and sat on the leadership team above it. I\'ve shaped revenue strategies across the bowtie – acquisition, customer success, expansion. So I start where the spend isn\'t working, then name what it\'s really a symptom of: usually the operating model catching up with the growth.',
  },
  {
    title: 'The people side of growth.',
    body: 'A strategy is easy to write down. Whether it lands depends on the team: alignment, trust, the safety to say what isn\'t working. I look at the conversations that aren\'t happening as closely as I look at the funnel.',
  },
  {
    title: 'A steady hand when it\'s hardest.',
    body: 'Twice I\'ve been the constant while the company around me went through existential change – a downsize, an acquisition, a leadership rebuild. I know what it costs to be that close. Now I can stand close to it without being consumed by it.',
  },
  {
    title: 'A guide between business cultures.',
    body: 'I led a European company\'s move into North America – opened the office, hired the first team – and later ran global marketing for an American company. I understand how culture varies between the US and Europe, between a startup and a Fortune 500 company, and how to use what each does well.',
  },
  {
    title: 'A framework for what AI changes.',
    body: 'AI is changing what marketing teams do and how they\'re built. My framework maps what to automate, what to protect, and how to grow the team through it.',
  },
];

// How it starts – shown inside the closing night band.
const steps = [
  {
    num: '01',
    title: 'A forty-five-minute conversation.',
    body: 'No deck, no pitch. I ask what\'s actually going on. You ask whatever you need to. We both leave knowing whether this makes sense.',
  },
  {
    num: '02',
    title: 'A short first scope.',
    body: 'If it does make sense, I\'ll suggest where to start – usually a contained first engagement before anything long-term.',
  },
  {
    num: '03',
    title: 'Honesty if it doesn\'t fit.',
    body: 'If the fit isn\'t right – timing, need, chemistry – I\'ll say so. And if I can point you somewhere better, I will.',
  },
];
---

<BaseLayout
  title="Practice – Stève Cattin"
  description="Who I work with, what I offer, and how to find out if we're a match."
>
  <div class="glow-scope">
  <GlowBackground strength={0.3} />

  <!-- Hero: one column – headline, then the story at reading width -->
  <section class="practice-hero">
    <div class="container-wide practice-hero__inner">
      <h1 class="practice-hero__title">
        Let's write <span class="accent">your</span> story.
      </h1>
      <div class="practice-hero__side">
        <p class="practice-hero__lede">
          <b>Every company wants to write its success story.</b>
          Some are stuck on the first chapter and can't get to the second.
          Some are starting a new one: a new market, a new product. Some are
          rewriting it under pressure, with the clock running. And some have
          the best possible problem: the story is moving faster than the
          company, and the team, the brand and the operating model need to catch
          up – before the money starts going to the wrong things. I've been there –
          through rapid expansion and downsizes, leadership shakeups, M&amp;A
          processes, and the quiet moments when nobody knows what to say.
        </p>
      </div>
    </div>
  </section>

  <!-- When to work with me: the heading holds its place while the four
       moments scroll past on the right. -->
  <section id="when" class="practice-section practice-moments" aria-labelledby="moments-title">
    <div class="container-wide practice-split">
      <header class="practice-split__head practice-split__head--sticky">
        <p class="section-eyebrow">When to work with me</p>
        <h2 id="moments-title" class="section-title">If you recognize yourself here…</h2>
        <p class="practice-moments__aside">Investor with a portfolio company in one of these moments? Same conversation.</p>
      </header>

      <ol class="practice-moments__list">
        {moments.map((m, i) => (
          <li class="practice-moments__item">
            <span class="num">№ {String(i + 1).padStart(2, '0')}</span>
            <h3 class="practice-moments__title">{m.title}</h3>
            <p class="practice-moments__body">{m.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials featuredId="kristin-johnsen" eyebrow="" title="" />

  <!-- Engagement modes -->
  <section id="modes" class="practice-section practice-modes" aria-labelledby="modes-title">
    <div class="container-wide">
      <h2 id="modes-title" class="section-title practice-head">Three ways to work together.</h2>

      <ol class="modes-list">
        {modes.map((m) => (
          <li class="practice-modes__item">
            <svg class="mode-glyph" viewBox="0 0 160 112" aria-hidden="true" focusable="false">
              {m.glyph === 'seat' && (
                <>
                  <circle class="mode-glyph__org" cx="80" cy="56" r="46" />
                  <circle class="mode-glyph__team" cx="60" cy="38" r="3.5" />
                  <circle class="mode-glyph__team" cx="101" cy="40" r="3.5" />
                  <circle class="mode-glyph__team" cx="58" cy="75" r="3.5" />
                  <circle class="mode-glyph__team" cx="100" cy="76" r="3.5" />
                  <circle class="mode-glyph__halo" cx="80" cy="57" r="16" />
                  <circle class="mode-glyph__me" cx="80" cy="57" r="6.5" />
                </>
              )}
              {m.glyph === 'beside' && (
                <>
                  <circle class="mode-glyph__org" cx="80" cy="56" r="46" />
                  <circle class="mode-glyph__team" cx="62" cy="40" r="3.5" />
                  <circle class="mode-glyph__team" cx="96" cy="38" r="3.5" />
                  <circle class="mode-glyph__team" cx="66" cy="74" r="3.5" />
                  <circle class="mode-glyph__team" cx="98" cy="73" r="3.5" />
                  <circle class="mode-glyph__team" cx="80" cy="57" r="3.5" />
                  <line class="mode-glyph__link" x1="128" y1="56" x2="146" y2="56" />
                  <circle class="mode-glyph__halo" cx="154" cy="56" r="16" />
                  <circle class="mode-glyph__me" cx="154" cy="56" r="6.5" />
                </>
              )}
              {m.glyph === 'one' && (
                <>
                  <circle class="mode-glyph__room" cx="64" cy="56" r="30" />
                  <circle class="mode-glyph__them" cx="52" cy="56" r="6.5" />
                  <circle class="mode-glyph__halo" cx="77" cy="56" r="16" />
                  <circle class="mode-glyph__me" cx="77" cy="56" r="6.5" />
                </>
              )}
            </svg>
            <p class="practice-modes__meta">{m.meta}</p>
            <h3 class="practice-modes__title">{m.title}</h3>
            <p class="practice-modes__fit">{m.fit}</p>
            <p class="practice-modes__body">{m.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why me – what I bring to the room; the depth is on About -->
  <section class="practice-section practice-why" aria-labelledby="why-title">
    <div class="container-wide v2-split">
      <header class="practice-why__head">
        <p class="section-eyebrow">Why me</p>
        <h2 id="why-title" class="section-title">What I bring to the room.</h2>
      </header>
      <div>
        <ul class="practice-why__list">
          {reasons.map((r) => (
            <li class="practice-why__item">
              <h3 class="practice-why__title">{r.title}</h3>
              <div>
                <p class="practice-why__body">{r.body}</p>
                {r.link && (
                  <a href={r.link} class="text-link practice-why__item-link">{r.linkText}</a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <a href="/about" class="text-link practice-why__link">Learn more about me on the About page →</a>
      </div>
    </div>
  </section>

  <Testimonials
    featuredId="nicolette-brenden"
    rowIds={["karen-clarke", "christina-nahal", "berin-sadikovic", "benedikt-koppel"]}
    title=""
    lead
  />

  <CTABlock
    id="book"
    wide
    night
    eyebrow="How it starts"
    headline="The best way to know is a conversation."
    ctaLabel="Tell me your story →"
    ctaModal={true}
  >
    <ol class="night-steps">
      {steps.map((st) => (
        <li class="night-steps__item">
          <span class="night-steps__num">{st.num}</span>
          <h3 class="night-steps__title">{st.title}</h3>
          <p class="night-steps__body">{st.body}</p>
        </li>
      ))}
    </ol>
  </CTABlock>
  </div>
</BaseLayout>

<style>
  /* Design principles v2: one paper ground with hairlines, type-led lists,
     asymmetric two-column layouts, one action ("Tell me your story"). */

  /* -------- Shared (eyebrow, title, text-link live in global.css) -------- */
  .num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .practice-section {
    padding-block: var(--space-24);
    border-top: 0.5px solid var(--color-line);
    scroll-margin-top: 64px;
  }

  /* Heading left, content right (≈5:7). */
  .practice-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .practice-split__head--sticky {
    position: sticky;
    top: 112px;
  }

  .practice-split--intro {
    align-items: end;
    margin-bottom: var(--space-16);
  }

  .practice-head { margin-bottom: var(--space-16); }

  .practice-intro {
    font-size: 16px;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 52ch;
    margin: 0;
  }
  .practice-intro a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* -------- Hero -------- */
  .practice-hero {
    padding-block: clamp(4rem, 4vw + 3rem, 7rem) var(--space-24);
  }

  .practice-hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }

  /* Story text at a comfortable reading width under the headline. */
  .practice-hero__side { max-width: 64ch; }

  .practice-hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(52px, 7vw, 104px);
    line-height: 0.96;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .practice-hero__title .accent { color: var(--color-cobalt); }

  .practice-hero__lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
  }

  .practice-hero__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    margin: 0;
  }
  /* The opening line stands out; the rest reads as plain text. */
  .practice-hero__lede b { color: var(--color-ink); font-weight: 500; }


  /* -------- The four moments -------- */
  .practice-moments__aside {
    margin: var(--space-6) 0 0;
    font-size: 16px;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 36ch;
  }

  .practice-moments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .practice-moments__item {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .practice-moments__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }

  .practice-moments__body {
    font-size: 17px;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    margin: 0;
    max-width: 62ch;
  }

  /* -------- Typographic grid (pillars, modes) -------- */
  .practice-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12) var(--space-10);
  }

  .practice-grid__item {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-6);
  }

  .practice-grid__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-3);
  }

  .practice-grid__body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0 0 var(--space-4);
  }

  .practice-grid__item .text-link { margin-top: auto; }

  /* -------- Modes: three seats, three glyphs --------
     The circle is the company, the cobalt dot is me: inside it, beside it,
     or one to one with you. */
  .modes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-12) var(--space-10);
  }

  .practice-modes__item {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-8);
  }

  .mode-glyph {
    width: 160px;
    height: 112px;
    margin: 0 0 var(--space-6) -34px;
    overflow: visible;
  }
  .mode-glyph__org { fill: none; stroke: var(--color-ink); stroke-width: 1.25; }
  .mode-glyph__room { fill: none; stroke: var(--color-ink); stroke-width: 1.25; stroke-dasharray: 3 4; }
  .mode-glyph__team { fill: color-mix(in srgb, var(--color-ink) 35%, transparent); }
  .mode-glyph__them { fill: var(--color-ink); }
  .mode-glyph__link { stroke: var(--color-ink); stroke-width: 1.25; stroke-dasharray: 2 3; }
  .mode-glyph__me { fill: var(--color-cobalt); }
  .mode-glyph__halo {
    fill: var(--color-glow-blue);
    opacity: 0.22;
    filter: blur(6px);
  }
  @keyframes mode-glow { 0%, 100% { opacity: 0.16; } 50% { opacity: 0.34; } }
  @media (prefers-reduced-motion: no-preference) {
    .mode-glyph__halo { animation: mode-glow 3.6s ease-in-out infinite; }
    .practice-modes__item:nth-child(2) .mode-glyph__halo { animation-delay: 1.2s; }
    .practice-modes__item:nth-child(3) .mode-glyph__halo { animation-delay: 2.4s; }
  }

  .practice-modes__meta {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ash);
    margin: 0 0 var(--space-3);
  }

  .practice-modes__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 38px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
  }

  /* "Right for you if…" comes first – it's how you choose. */
  .practice-modes__fit {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
  }

  .practice-modes__body {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-graphite);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 0.5px solid var(--color-line);
  }

  /* -------- Why me: four lines, hairlines -------- */
  .practice-why__link { display: inline-block; margin-top: var(--space-8); }
  .practice-why__item-link { display: inline-block; margin-top: var(--space-3); font-size: 15px; }
  .practice-why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .practice-why__item {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: baseline;
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .practice-why__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }
  .practice-why__body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-graphite);
    margin: 0;
  }
  @media (max-width: 640px) {
    .practice-why__item { grid-template-columns: 1fr; gap: var(--space-2); }
  }

  /* -------- How it starts (inside the night band) -------- */
  .night-steps {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
    max-width: 1080px;
  }
  .night-steps__item {
    border-top: 1px solid color-mix(in srgb, var(--color-night-powder) 28%, transparent);
    padding-top: var(--space-5);
  }
  .night-steps__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-night-powder);
    margin-bottom: var(--space-3);
  }
  .night-steps__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    margin: 0 0 var(--space-2);
  }
  .night-steps__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-night-haze);
    margin: 0;
  }

  /* -------- Responsive -------- */
  @media (max-width: 1000px) {
    .practice-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .modes-list { grid-template-columns: 1fr; gap: var(--space-4); }
    .practice-modes__item { display: grid; grid-template-columns: 180px minmax(0, 1fr); column-gap: var(--space-8); }
    .practice-modes__item > * { grid-column: 2; }
    .practice-modes__item > .mode-glyph { grid-column: 1; grid-row: 1 / span 4; }
    .night-steps { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  @media (max-width: 800px) {
    .practice-split { grid-template-columns: 1fr; }
    .practice-split__head--sticky { position: static; }
    .practice-split--intro { margin-bottom: var(--space-10); }
  }

  @media (max-width: 640px) {
    .practice-section { padding-block: var(--space-16); }
    .practice-grid { grid-template-columns: 1fr; }
    .practice-modes__item { display: flex; }
    .mode-glyph { width: 128px; height: 90px; margin-left: -27px; }
  }
</style>
