---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import Testimonials from '../components/Testimonials.astro';

const moments = [
  {
    title: "Your go-to-market grew by instinct. Now it has to grow by design.",
    body: "A hire here, a tool there, an agency no one quite knows how to brief. It worked… until it didn't anymore. A round just closed, a first senior hire didn't land, or a new CEO arrived and is asking what has actually been built and how to scale and grow. Before you invest in the next stage, we work out what to build, what to buy, and what to stop paying for.",
  },
  {
    title: "Growth has stalled, and no one can say why.",
    body: "The funnel is shrinking. Targets get missed, quarter after quarter. Your revenue leaders are working harder than ever, and still, friction between teams slows everything down. It's rarely just a broken funnel. More often, it's a team fighting a system it has outgrown. I look at both.",
  },
  {
    title: "You're taking something new to market.",
    body: "A new country – Europe to North America, say. A new product, or a new segment. Or it's already out there, and it's harder than the plan said. We work out where it's likely to break – the story, the team, the way you sell – and fix that first.",
  },
  {
    title: "Something big is coming.",
    body: "A raise, an exit, a restructuring. The board wants a serious plan. The team needs someone who has been through it before, knows what it feels like, and can hold everything together. That's the seat I take: alongside the CEO, in front of investors, and with the team.",
  },
];

const modes = [
  {
    title: 'Fractional executive.',
    body: 'One to three days a week, in the seat. I usually come in on the function that\'s most exposed – for a company scaling past its structure, that\'s typically marketing or GTM. But it rarely stays in one box. I\'ve run People and Operations too, and sat on the executive team – so I hire who needs hiring, decide what needs deciding, free you to focus on what only you can do, and I\'m in the room for what fits no single function: vision, product, the calls only the leadership team can make.',
    fit: 'Right for you if you need someone who can hold a function and think about the whole company alongside you.',
  },
  {
    title: 'Advisory.',
    body: 'A regular cadence outside the org chart. For founders and execs who already have a team and a plan, and want a senior operator to think with – about the next quarter\'s bets, the leadership decisions that don\'t have an obvious right answer, the conversations you\'d rather not have alone. I\'m not in the day-to-day, but close enough to the work to be useful.',
    fit: 'Right for you if the team is in place and what you need is a trusted person to pressure-test the plan.',
  },
  {
    title: 'Sparring, privately.',
    body: 'For leaders who sense the hardest problem they\'re carrying is the one inside themselves. A room with no audience and no agenda – confidential, off the org chart, off the record. Just the time to think it through with someone who has been in your seat, and seen this kind of problem up close, more than once.',
    fit: 'Right for you if what\'s getting in the way isn\'t the company – it\'s you, and you want someone to think it through with.',
  },
];

const pillars = [
  {
    title: 'The whole engine, not just marketing.',
    body: 'I\'ve built marketing inside scaling companies and sat on the leadership team above it. I\'ve shaped revenue strategies across the bowtie – acquisition, customer success, expansion. So I start where the spend isn\'t working, then name what it\'s really a symptom of: usually the operating model catching up with the growth.',
  },
  {
    title: 'The people side of growth.',
    body: 'A strategy is easy to write down. Whether it lands depends on the team: alignment, trust, the safety to say what isn\'t working. I look at the conversations that aren\'t happening as closely as I look at the funnel.',
  },
  {
    title: 'A steady hand when it\'s hardest.',
    body: 'Twice I\'ve been the constant while the company around me went through existential change – a downsize, an acquisition, a leadership rebuild. I know what it costs to be that close. Now I can stand close to it without being consumed by it.',
  },
  {
    title: 'Two exits, from the inside.',
    body: 'Operating leader and shareholder through both, on the deal team for the second, and the integration work after. I know what a company has to look like before the process starts.',
  },
  {
    title: 'A guide between business cultures.',
    body: 'I led a European company\'s move into North America – opened the office, hired the first team – and later ran global marketing for an American company. I understand how culture varies between the US and Europe, between a startup and a Fortune 500 company, and how to use what each does well.',
  },
  {
    title: 'A framework for what AI changes.',
    body: 'AI is changing what marketing teams do and how they\'re built. My framework maps what to automate, what to protect, and how to grow the team through it.',
    link: '/aima',
    linkText: 'Explore the framework →',
  },
];

const steps = [
  {
    num: '01',
    title: 'A forty-five-minute conversation.',
    body: 'No deck, no pitch. I ask what\'s actually going on. You ask whatever you need to. We both leave knowing whether this makes sense.',
  },
  {
    num: '02',
    title: 'A short first scope.',
    body: 'If it does make sense, I\'ll suggest where to start – usually a contained first engagement before anything long-term. I don\'t do six-month commitments before we\'ve worked together once.',
  },
  {
    num: '03',
    title: 'Honesty if it doesn\'t fit.',
    body: 'If the fit isn\'t right – timing, need, chemistry – I\'ll say so. And if I can point you somewhere better, I will.',
  },
];
---

<BaseLayout
  title="Practice – Stève Cattin"
  description="Who I work with, what I offer, and how to find out if we're a match."
>
  <!-- Hero -->
  <section class="practice-hero container">
    <h1 class="practice-hero__title">
      Let's write <span class="accent">your</span> story.
    </h1>
    <p class="practice-hero__lede">
      Every company wants to write its success story. Some are stuck on the
      first chapter and can't get to the second. Some are starting a new one:
      a new market, a new product. Some are rewriting it under pressure, with
      the clock running. And some have the best possible problem: the story is
      moving faster than the company, and the team, the brand and the operating
      model need to catch up – before the money starts going to the wrong
      things. I've been there – through rapid expansion and downsizes,
      leadership shakeups, M&A processes, and the quiet moments when nobody
      knows what to say.
    </p>
  </section>

  <!-- When to work with me -->
  <section id="when" class="practice-audiences section container">
    <header class="practice-audiences__header">
      <p class="eyebrow">When to work with me</p>
      <h2>If you recognize yourself here…</h2>
    </header>

    <ol class="practice-audiences__list">
      {moments.map((m, i) => (
        <li class="practice-audiences__item">
          <span class="practice-audiences__num">№ {String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="practice-audiences__title">{m.title}</h3>
            <p class="practice-audiences__note">{m.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="practice-audiences__aside">Investor with a portfolio company in one of these moments? Same conversation.</p>
  </section>

  <!-- No rule after this one – the quote is itself the break between the
       recognition list and the offer. -->
  <Testimonials featuredId="kristin-johnsen" eyebrow="" title="" width="content" />

  <!-- Pillars -->
  <section class="practice-pillars section container">
    <header class="practice-pillars__header">

      <h2>What I bring to the room.</h2>
    </header>

    <div class="practice-pillars__grid">
      {pillars.map((p, i) => (
        <article class="practice-pillars__card">
          <span class="practice-pillars__num">№ {String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          {p.link && (
            <a href={p.link} class="practice-pillars__card-link">{p.linkText}</a>
          )}
        </article>
      ))}
    </div>

    <p class="practice-pillars__note">
      Want to understand more about who I am and how I think before reaching out?
      The <a href="/about">About page</a> has the path, the philosophy, and what
      twenty years of this work has actually taught me.
    </p>
  </section>

  <hr class="rule" />

  <!-- Engagement modes -->
  <section class="practice-modes section container">
    <header class="practice-modes__header">

      <h2>Three ways to work together.</h2>
    </header>

    <div class="practice-modes__grid">
      {modes.map((m, i) => (
        <article class="practice-modes__card">
          <span class="practice-modes__num">№ {String(i + 1).padStart(2, '0')}</span>
          <h3><span>{m.title}</span></h3>
          <p>{m.body}</p>
          <p class="practice-modes__fit">{m.fit}</p>
        </article>
      ))}
    </div>
  </section>

  <Testimonials rowIds={["karen-clarke", "christina-nahal", "berin-sadikovic"]} />

  <CTABlock
    id="book"
    eyebrow="Are we a match?"
    headline="The best way to know is a conversation."
    body="Forty-five minutes. No deck, no pitch. I'll ask what's actually going on, and we'll see whether this makes sense for both of us."
    ctaLabel="Reach out"
    ctaModal={true}
    secondaryLabel="Read some writing first"
    secondaryHref="/blog"
  />
</BaseLayout>

<style>
  /* -------- Hero -------- */
  /* No max-width here – the container sets the frame so the left edge lines up
     with every section below. Reading measure is capped per element instead. */
  /* Top padding only. The section below brings its own 96px top padding, so
     giving the hero a bottom padding too just stacks two gaps into one. */
  .practice-hero {
    padding-top: clamp(4rem, 4vw + 3rem, 7rem);
    padding-bottom: 0;
  }


  .practice-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-6);
    max-width: 14ch;
  }
  .practice-hero__title .accent {
    color: var(--color-cobalt);
  }

  .practice-hero__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 60ch;
  }

  /* -------- Audiences -------- */
  .practice-audiences__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }

  .practice-modes__cta {
    display: flex;
    align-items: center;
    width: fit-content;
    margin-top: var(--space-12);
    margin-inline: auto;
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    background: var(--color-cobalt);
    color: var(--color-paper);
    border: none;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .practice-modes__cta:hover {
    background: var(--color-ink);
  }

  .practice-audiences__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .practice-audiences__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .practice-audiences__item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  .practice-audiences__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .practice-audiences__num {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cobalt);
    font-weight: 500;
  }

  .practice-audiences__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-2);
    max-width: 40ch;
  }

  .practice-audiences__aside {
    margin-top: var(--space-6);
    font-family: var(--font-accent);
    font-style: italic;
    color: var(--color-ash);
  }

  .practice-audiences__note {
    font-size: 1.02rem;
    line-height: var(--lh-normal);
    color: var(--color-ink);
    max-width: 62ch;
  }

  /* -------- Modes -------- */
  .practice-modes__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }
  .practice-modes__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .practice-modes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .practice-modes__card {
    background: var(--color-white);
    border: 0.5px solid var(--color-line);
    padding: var(--space-7);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .practice-modes__num {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cobalt);
    font-weight: 500;
  }

  .practice-modes__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.4;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .practice-modes__card h3 span {
    color: var(--color-paper);
    background-color: var(--color-cobalt);
    padding: 2px 6px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .practice-modes__card p {
    font-size: 0.98rem;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
  }

  .practice-modes__fit {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem !important;
    color: var(--color-ink) !important;
    font-style: italic;
  }

  /* -------- Pillars -------- */
  .practice-pillars__intro {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    color: var(--color-graphite);
    max-width: 62ch;
    margin-bottom: var(--space-10);
  }

  .practice-pillars__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }
  .practice-pillars__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .practice-pillars__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .practice-pillars__card {
    background: var(--color-white);
    border: 0.5px solid var(--color-line);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .practice-pillars__num {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cobalt);
    font-weight: 500;
  }

  .practice-pillars__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .practice-pillars__card p {
    font-size: 0.98rem;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
  }

  .practice-pillars__card-link {
    font-size: 0.9rem;
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: auto;
  }

  /* -------- Process -------- */
  .practice-process__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }

  .practice-process__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .practice-process__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 760px;
  }

  .practice-process__item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  .practice-process__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .practice-process__num {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-cobalt);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
  }

  .practice-process__content h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .practice-process__content p {
    font-size: 1.02rem;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 58ch;
  }

  .practice-pillars__note {
    margin-top: var(--space-10);
    font-size: 0.95rem;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
  }

  .practice-pillars__note a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* -------- Bridge -------- */
  .practice-bridge {
    padding-block: var(--space-10);
  }

  .practice-bridge p {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    color: var(--color-graphite);
  }

  .practice-bridge a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* -------- Responsive -------- */
  @media (max-width: 800px) {
    .practice-pillars__grid { grid-template-columns: 1fr; }
    .practice-modes__grid { grid-template-columns: 1fr; }
    .practice-audiences__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .practice-process__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
