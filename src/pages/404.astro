---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlowRing from '../components/GlowRing.astro';
import NightLights from '../components/NightLights.astro';
---

<BaseLayout
  title="Page not found"
  description="This page isn't here. The rest is."
  noIndex={true}
>
  <!-- v3: one night screen, and the glowing ring with nothing inside. -->
  <section class="notfound v3-night v3-night--end v3-night--top">
    <NightLights coral pale={false} openTop />
    <div class="notfound__inner container-wide">
      <div class="notfound__copy">
        <p class="section-eyebrow">Error 404</p>
        <h1 class="notfound__title">
          This page isn't here.<br />
          <span class="accent">The rest is.</span>
        </h1>

        <p class="notfound__lead">
          A dead link, an old URL, or a small typo. No harm done – the rest of
          the site is very much here.
        </p>

        <div class="notfound__actions">
          <a href="/" class="v3-btn">Back to home</a>
          <a href="/blog" class="v3-link">Read the writing</a>
        </div>
      </div>

      <GlowRing size={360} sizeSm={220} class="notfound__ring" />
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-h) + 40px) var(--space-16);
    box-sizing: border-box;
  }

  .notfound__inner {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }

  .notfound__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--color-white);
    margin: 0;
  }

  .notfound__lead {
    margin: 32px 0 40px;
    max-width: 520px;
    font-size: 19px;
    line-height: var(--lh-normal);
    color: var(--color-night-powder);
  }

  .notfound__actions {
    display: flex;
    align-items: center;
    gap: var(--space-7, 28px);
    flex-wrap: wrap;
  }

  .notfound :global(.notfound__ring) { margin-right: 40px; }

  @media (max-width: 760px) {
    .notfound__inner { grid-template-columns: 1fr; }
    .notfound :global(.notfound__ring) { margin: 0 auto; order: -1; }
  }
</style>
