  .aima-stage__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .aima-stage__cell {
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-5);
  }
  .aima-stage__cell p {
    font-size: 16px;
    line-height: var(--lh-normal);
    color: var(--color-ink);
    margin: 0;
  }
  .aima-stage:not([hidden]) { animation: aima-fade var(--dur-slow) var(--ease-out); }
  @keyframes aima-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .aima-subhead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(26px, 2.6vw, 34px);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-8);
  }

  .aima-pillar__intro {
    font-size: 17px;
    line-height: var(--lh-normal);
    color: var(--color-ink);
    max-width: 62ch;
    margin: var(--space-8) 0 var(--space-6);
  }

  .aima-callout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 2px solid var(--color-cobalt);
    max-width: 920px;
  }
  .aima-callout p {
    font-size: 17px;
    line-height: var(--lh-prose);
    color: var(--color-ink);
    margin: 0;
  }
  .aima-callout a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Growth framework ---------- */
  .aima-dims {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12) var(--space-10);
    margin-top: var(--space-10);
  }
  .aima-dim {
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-5);
  }
  .aima-dim__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .aima-dim__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0;
  }
  .aima-dim__def {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--color-ash);
  }
  .aima-dim__p {
    font-size: 15.5px;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    margin: 0;
  }
  .aima-dim__ai {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px dashed color-mix(in srgb, var(--color-cobalt) 30%, transparent);
  }
  .aima-dim__ai p {
    font-size: 15.5px;
    line-height: var(--lh-normal);
    color: var(--color-ink);
    margin: 0;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .aima-cols--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 1040px) {
    .aima-body { grid-template-columns: 1fr; }
    .aima-toc { display: none; }
    /* The scrub cone's halo box reaches 40px past the frame; on narrow
       screens clip it at the screen edge so the page never scrolls sideways.
       (clip, not hidden: no scroll container, nothing else changes.) */
    .aima-body { overflow-x: clip; }
  }

  @media (max-width: 860px) {
    .aima-made { grid-template-columns: 1fr; gap: var(--space-3); }
    .aima-ways__row { grid-template-columns: 48px minmax(0, 1fr) 20px; }
    .aima-ways__body { grid-column: 2; grid-row: 2; }
    .aima-ways__arrow { grid-column: 3; grid-row: 1; }
    .aima-table__head { display: none; }
    .aima-table__row { grid-template-columns: 1fr; gap: var(--space-3); }
    .aima-table__inline {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-mono-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-ash);
      margin-bottom: var(--space-1);
    }
    .aima-table--chal .aima-table__cell--ink .aima-table__inline { color: var(--color-cobalt); }
    .aima-cols--3,
    .aima-stage__grid,
    .aima-uc__notes,
    .aima-dims,
    .aima-callout { grid-template-columns: 1fr; }
    .aima-uc__notes { gap: var(--space-6); }
    .aima-callout { gap: var(--space-3); }
  }

  @media (max-width: 640px) {
    .aima-hero { padding-top: var(--space-12); padding-bottom: var(--space-12); }
    .aima-section { padding-block: var(--space-16); }
    .aima-cols--4 { grid-template-columns: 1fr; }
    .aima-tabs { gap: var(--space-5); }
    .aima-tab { font-size: 18px; }
    .aima-uc__summary { grid-template-columns: minmax(0, 1fr) 20px; }
    .aima-uc__count { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .aima-stage:not([hidden]) { animation: none; }
  }
</style>

<style is:global>
  /* ============================================================
     AIMA night – the closing band's ground, carried across the page.
     Scoped to a page that contains .aima--night, so nothing else on
     the site changes.

     The night covers the nav, the hero and the body. The closing band
     is the dawn – the sky brightens into paper, a coral sun on the
     horizon – and the footer is the site's usual paper again. The
     band, the footer and the contact sheet keep the day tokens.

     Text ramp: haze (headlines, strong copy) → powder mix (sub copy)
     → darker powder mix (metadata), all from the night tokens.
     Accent: night sky stands in for cobalt – cobalt on navy is about
     2:1 and disappears. Buttons are paper on navy (principle §8).
     Coral stays light only: the end of the cone, the sun at dawn.
     ============================================================ */
  html:has(.aima--night) { color-scheme: dark; }
  body:has(.aima--night) { background: var(--color-night); }

  body:has(.aima--night) :is(.aima--night > :not(.cta), .nav) {
    --color-ink:         var(--color-night-haze);
    --color-graphite:    color-mix(in srgb, var(--color-night-powder) 80%, var(--color-night));
    --color-ash:         color-mix(in srgb, var(--color-night-powder) 62%, var(--color-night));
    --color-line:        color-mix(in srgb, var(--color-night-haze) 14%, transparent);
    --color-line-subtle: color-mix(in srgb, var(--color-night-haze) 9%, transparent);
    --color-cobalt:      var(--color-night-sky);
    --color-cobalt-deep: var(--color-night-powder);
    --color-cobalt-tint: color-mix(in srgb, var(--color-night-sky) 14%, transparent);
    color: var(--color-ink);
  }

  /* ---------- The light: night blues and overlay grain ---------- */
  body:has(.aima--night) .glow__blob--1 {
    background: radial-gradient(circle at 50% 50%, var(--color-night-azure), var(--color-night-royal));
  }
  body:has(.aima--night) .glow__blob--2 {
    background: radial-gradient(circle at 50% 50%, var(--color-night-royal), var(--color-night-deep));
  }
  body:has(.aima--night) .glow__blob--3 {
    background: radial-gradient(circle at 50% 50%, var(--color-night-azure), var(--color-night-deep));
  }
  /* Overlay grain needs navy to blend with inside the light layer (its
     own stacking context) – without it the noise shows raw, as grey
     static. The spread shadow carries the navy past the layer's capped
     width; the stage clips it. */
  body:has(.aima--night) .glow {
    background: var(--color-night);
    box-shadow: 0 0 0 100vmax var(--color-night);
  }
  body:has(.aima--night) .glow__grain {
    background-image: url("/images/noise.png");
    mix-blend-mode: overlay;
    opacity: 0.36;
  }

  /* ---------- Nav: light type, dark glass ---------- */
  body:has(.aima--night) .nav.is-scrolled,
  body:has(.aima--night) .nav:has(.nav__mobile-menu.is-open) {
    background: color-mix(in srgb, var(--color-night) 62%, transparent);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05),
      0 12px 32px -20px rgba(0, 0, 0, 0.6);
  }
  @media (prefers-reduced-transparency: reduce) {
    body:has(.aima--night) .nav.is-scrolled,
    body:has(.aima--night) .nav:has(.nav__mobile-menu.is-open) { background: var(--color-night); }
  }
  body:has(.aima--night) .nav__mobile-menu { background: var(--color-night); }
  body:has(.aima--night) .nav__cta,
  body:has(.aima--night) .nav__mobile-cta {
    background: var(--color-paper);
    color: var(--color-night);
  }
  body:has(.aima--night) .nav__cta:hover {
    background: var(--color-night-powder);
    color: var(--color-night);
  }

  /* ---------- The cone: a beam of light in the dark ---------- */
  /* Start the beam from the glow blue, a touch brighter than cobalt,
     so the line at Aware still reads on navy. */
  body:has(.aima--night) .aima-cone stop:first-child { stop-color: var(--color-glow-blue) !important; }
  body:has(.aima--night) .aima-cone__halo { opacity: 0.8; }
  body:has(.aima--night) .aima-cone__ghost path { fill: color-mix(in srgb, var(--color-night-haze) 7%, transparent); }
  /* The "you are here" dot: bright blue, ringed in navy, with its halo. */
  body:has(.aima--night) .aima-cone__marker {
    background: var(--color-glow-blue);
    border-color: var(--color-night);
  }

  /* ---------- Dawn: the closing band ----------
     The band opens with a stretch of sky that starts at the page's
     navy and brightens through the night blues into paper. The copy
     sits on the paper, lit like the homepage hero: soft blue lights
     and one coral sun on the horizon line. Overlay grain works on both
     – texture in the sky, gone on the paper. Day tokens throughout. */
  body:has(.aima--night) .cta.cta--night {
    background: transparent; /* the band's own navy would show at the seam */
    --dawn-sky: clamp(220px, 24vw, 340px);
    padding-top: calc(var(--dawn-sky) + var(--space-12));
    margin-top: var(--space-10);
  }
  /* The sky fades in from nothing at the top (a mask on the whole
     layer – gradient, lights and grain), so the page's own light runs
     into the band with no seam and no clipped glow. */
  body:has(.aima--night) .cta--night .night-bg {
    background: linear-gradient(
      to bottom,
      var(--color-night) 0,
      var(--color-night-deep) calc(var(--dawn-sky) * 0.36),
      var(--color-night-royal) calc(var(--dawn-sky) * 0.52),
      var(--color-night-azure) calc(var(--dawn-sky) * 0.66),
      var(--color-night-sky) calc(var(--dawn-sky) * 0.79),
      var(--color-night-powder) calc(var(--dawn-sky) * 0.9),
      var(--color-paper) var(--dawn-sky)
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--dawn-sky) * 0.42));
    mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--dawn-sky) * 0.42));
  }

  /* The sun: coral, centred on the horizon, right of the copy. Its slow
     drift lifts it into the sky and lets it sink back. */
  body:has(.aima--night) .cta--night .cta__blob--3 {
    --sun: clamp(300px, 32vw, 440px);
    width: var(--sun); height: var(--sun);
    top: calc(var(--dawn-sky) - var(--sun) / 2);
    left: 60%;
    background: radial-gradient(circle at 50% 50%, var(--color-night-coral-soft), var(--color-night-coral));
    filter: blur(96px);
    opacity: 0.75;
    mix-blend-mode: normal;
  }
  /* Morning blues on the paper: one low left, one far right. */
  body:has(.aima--night) .cta--night .cta__blob--1 {
    width: 620px; height: 620px;
    top: calc(var(--dawn-sky) + 40px);
    left: -260px;
    background: radial-gradient(circle at 50% 50%, var(--color-glow-blue-soft), var(--color-glow-blue));
    filter: blur(170px);
    opacity: 0.32;
  }
  body:has(.aima--night) .cta--night .cta__blob--2 {
    width: 560px; height: 560px;
    top: calc(var(--dawn-sky) + 120px);
    left: 82%;
    background: radial-gradient(circle at 50% 50%, var(--color-glow-blue-soft), var(--color-glow-cobalt-soft));
    filter: blur(170px);
    opacity: 0.28;
  }

  /* Copy and actions back on paper: cobalt eyebrow, ink headline,
     cobalt button (as in a hero), quiet ink link. (.cta.cta--night:
     one class more than CTABlock's own scoped night rules.) */
  body:has(.aima--night) .cta.cta--night .cta__eyebrow { color: var(--color-cobalt); }
  body:has(.aima--night) .cta.cta--night .cta__headline { color: var(--color-ink); }
  body:has(.aima--night) .cta.cta--night .cta__body { color: var(--color-graphite); }
  body:has(.aima--night) .cta.cta--night .cta__btn.cta__btn--primary {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }
  body:has(.aima--night) .cta.cta--night .cta__btn.cta__btn--primary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  body:has(.aima--night) .cta.cta--night .cta__btn.cta__btn--secondary {
    color: var(--color-ink);
    text-decoration-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  body:has(.aima--night) .cta.cta--night .cta__btn.cta__btn--secondary:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-cobalt);
  }

  /* The day continues into the footer: plain paper, as on every page. */
  body:has(.aima--night) main + .footer { background: var(--color-paper); }
</style>

<script>
  /* Tabs: each [data-switch-btn=KEY] shows [data-switch-panel=KEY] within
     its own [data-switch] group. Listeners sit on the buttons themselves,
     and the arrow keys move between tabs. */
  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((group) => {
    const own = (sel: string) =>
      Array.from(group.querySelectorAll<HTMLElement>(sel)).filter((el) => el.closest('[data-switch]') === group);
    const tabs = own('[data-switch-btn]') as HTMLButtonElement[];
    const panels = own('[data-switch-panel]');
    if (!tabs.length) return;

    const show = (tab: HTMLButtonElement, focus = false) => {
      const key = tab.dataset.switchBtn;
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) t.removeAttribute('tabindex'); else t.setAttribute('tabindex', '-1');
      });
      panels.forEach((p) => { p.hidden = p.dataset.switchPanel !== key; });
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab));
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        show(tabs[next], true);
      });
    });
  });

  /* Sticky index scroll-spy: highlight the section nearest the viewport middle. */
  const tocLinks = Array.from(document.querySelectorAll('.aima-toc__link')) as HTMLAnchorElement[];
  const linkFor = new Map<Element, HTMLAnchorElement>();
  tocLinks.forEach((link) => {
    const href = link.getAttribute('href');
    if (!href) return;
    const section = document.getElementById(href.slice(1));
    if (section) linkFor.set(section, link);
  });
  if (linkFor.size) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const active = linkFor.get(entry.target);
          if (!active) return;
          tocLinks.forEach((l) => l.classList.remove('is-active'));
          active.classList.add('is-active');
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    linkFor.forEach((_, section) => spy.observe(section));
  }
</script>
