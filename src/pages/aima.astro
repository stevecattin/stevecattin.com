<script>
  /* Generic scoped switcher: buttons [data-switch-btn=KEY] toggle panels
     [data-switch-panel=KEY] within the nearest [data-switch]. Handles nesting
     (pillar tabs contain their own stage stepper) by matching on closest(). */
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-switch-btn]') as HTMLElement | null;
    if (!btn) return;
    const scope = btn.closest('[data-switch]') as HTMLElement | null;
    if (!scope) return;
    const key = btn.getAttribute('data-switch-btn');

    scope.querySelectorAll('[data-switch-btn]').forEach((b) => {
      if (b.closest('[data-switch]') === scope) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      }
    });
    scope.querySelectorAll('[data-switch-panel]').forEach((p) => {
      if (p.closest('[data-switch]') === scope) {
        (p as HTMLElement).hidden = p.getAttribute('data-switch-panel') !== key;
      }
    });
  });

  /* Sticky index scroll-spy: highlight the section nearest the viewport middle. */
  const tocLinks = Array.from(document.querySelectorAll('.aima-toc__link')) as HTMLAnchorElement[];
  const linkFor = new Map<Element, HTMLAnchorElement>();
  tocLinks.forEach((link) => {
    const href = link.getAttribute('href');
    if (!href) return;
    const section = document.getElementById(href.slice(1));
    if (section) linkFor.set(section, link);
  });
  if (linkFor.size) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const active = linkFor.get(entry.target);
          if (!active) return;
          tocLinks.forEach((l) => l.classList.remove('is-active'));
          active.classList.add('is-active');
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    linkFor.forEach((_, section) => spy.observe(section));
  }
</script>
