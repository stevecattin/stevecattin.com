---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';

const tango    = `<a href="https://tangoanalytics.com" target="_blank" rel="noopener noreferrer">Tango</a>`;
const locatee  = `<a href="https://www.venturelab.swiss/Locatee-acquired-by-Tango-creating-industrys-first-holistic-workplace-analytics-solution" target="_blank" rel="noopener noreferrer">Locatee</a>`;
const felfel   = `<a href="https://felfel.ch/en" target="_blank" rel="noopener noreferrer">FELFEL</a>`;
const aspediens= `<a href="https://www.consultancy.uk/news/12313/csc-acquires-european-cloud-services-firm-aspediens" target="_blank" rel="noopener noreferrer">Aspediens</a>`;
const dxc      = `<a href="https://dxc.com" target="_blank" rel="noopener noreferrer">DXC Technology</a>`;
const parker   = `<a href="https://www.parker.com/us/en/home.html" target="_blank" rel="noopener noreferrer">Parker Hannifin</a>`;
const ehl      = `<a href="https://www.ehl.edu" target="_blank" rel="noopener noreferrer">École hôtelière de Lausanne</a>`;

const milestones = [
  { year: '2025', note: `SVP Marketing at ${tango}. Came in through the acquisition, took the team over, ended up on the executive leadership team of the company that bought us. PE-backed, US-headquartered. Combining American ambition with European execution.` },
  { year: '2024', note: `Second exit: ${locatee} acquired by ${tango}. We restructured the company and ran a sale process under pressure. I sat at the table with our co-CEOs, CFO, board, and the acquirer – while holding the team together through it.` },
  { year: '2020', note: `Joined ${locatee} post Series A as Head of Marketing. Building the organization for scale.` },
  { year: '2017', note: `Bringing Good Food at Work to more employees, as Growth Lead at ${felfel}. A passion for a physical product, designed and shipped into real offices.` },
  { year: '2016', note: `First exit. ${aspediens} acquired by CSC/${dxc}. Suddenly colleagues on every continent and a Fortune 500 brand to integrate. The work shifted to building bridges – between teams, countries, and two very different ways of doing business.` },
  { year: '2013', note: `Joined ${aspediens} as Head of Marketing. 30 people on day one. 100+ the day we were acquired.` },
  { year: '2012', note: `Coordinating digital marketing across 25 countries at ${parker}. First taste of how a Fortune 500 actually moves – and where the gap sits between HQ and the field.` },
  { year: '2005', note: `First job. ${ehl} – seven years, intern to manager. The world's leading hospitality school doesn't just teach you to love detail. It trains you to read a room: who feels welcome, who doesn't, what the energy needs. Years later, colleagues would call this out as something they noticed about working with me. The origin is here.` },
];

const principles = [
  {
    title: 'Clarity before cleverness.',
    body: 'I would rather say the obvious thing first and be useful than say the interesting thing first and be impressive. Most founders are drowning in clever. What they need is a person who will tell them the obvious, out loud.',
  },
  {
    title: 'Curiosity is the work.',
    body: 'The best solutions don\'t live in any one person\'s head. Curiosity allows me to tap into the collective intelligence, and surface what no single perspective could see alone. It also implies the need for a low ego, that makes it possible to be genuinely open to someone else\'s point of view. It all travels together: when you stay curious, and hold your ideas loosely, you give everyone – including yourself – the best shot at the right answer.',
  },
  {
    title: 'A love for human beings.',
    body: 'I hold the operator and the human at the same time… and the spreadsheet and the late-night conversation. People work with me because business and the people who make the business matter equally. I listen, make it safe and hold space. Oh, and I tell jokes.',
  },
  {
    title: 'Less, but fully.',
    body: 'Discipline, thoughtfulness and essentialism are some of the words you\'ll hear me use when describing how I work. Most problems don\'t need more – they need less, done better, repeatedly. It means finding the lever that moves everything else, and pulling it with full attention. Constant progress on the right problem beats frantic motion on the wrong ones every time.',
  },
];
---

<BaseLayout
  title="About Stève Cattin"
  description="Fifteen years in B2B tech, two exits, and a genuine love for the obvious question nobody's asking."
>
  <!-- Hero -->
  <section class="about-hero container">
    <p class="eyebrow">About</p>
    <h1 class="about-hero__title">
      The obvious question is usually the <span class="accent">right</span> one.
    </h1>
    <p class="about-hero__lede">
      I help founders and senior leaders solve their challenges,
      with care, respect and curiosity. Marketer by training with a People &amp;
      Operations track record. Storyteller and advisor wherever I'm allowed.
    </p>
  </section>

  <!-- The Learning(s) -->
  <section class="about-body container-prose section-tight">
    <h2>The Learning(s)</h2>

    <p>
      When something isn't working, it's rarely just the plan. And it's rarely
      just the team. It's usually the space, the stories and the conversations
      between them. Where clarity breaks down, where ownership gets fuzzy, where
      smart people produce the wrong results anyway.
    </p>

    <p><strong>I've spent most of my career working in those in-between spaces.</strong></p>
    <ul class="about-betweens">
      <li>Between the people building features and the customers paying for benefits – which is often the most expensive translation no one budgets for.</li>
      <li>Between American ambition and European execution.</li>
      <li>Between the strategy that makes sense on paper, the team that has to believe it enough to deliver it, and the operating system that makes the work progress.</li>
    </ul>

    <p>
      I'm drawn to people who are translating between worlds – a technical
      founder learning to be a storyteller, a marketer learning to run a P&amp;L,
      a CEO trying to build a company that matches who they actually are,
      rather than who they thought they were supposed to be.
    </p>

    <blockquote class="about-pullquote">
      I've been lucky enough to do that work from the inside and lived through
      some very defining experiences: <strong>2 acquisitions</strong>, building and scaling
      small-team Series A companies and also the difficult task of downsizing
      them. From <strong>VC-funded startups in Switzerland</strong>, <strong>Fortune 500
      companies</strong>, and all the way to the executive leadership of a
      <strong>US-headquartered, PE-backed company</strong>. From <strong>Marketing to People, to
      Operations</strong>. From hands-on work with the team – aligning elements on a
      slide deck – to <strong>strategic conversations with my peers and the Board</strong>.
    </blockquote>

    <p>
      Through it all, one constant: the better path is one made of curiosity,
      lack of ego and a genuine love for succeeding collectively rather than
      individually.
    </p>

    <h2>The Future</h2>

    <p>
      The obvious next step after a seat at the executive table would be another
      seat at the executive table. That's not what pulls me. What gives me
      energy is the creative part – solving problems, and the quiet conversation
      with a leader about what's really going on. I also want the future to hold
      space for a personal dream that is close to my heart, and this is why a
      different path attracts me:
    </p>

    <ul>
      <li>
        I want to sit with founders and CEOs whose teams are stuck and who
        can't quite name why. Where the strategy looks fine on paper, the hires
        are good, and yet things aren't landing.
      </li>
      <li>
        Or with board members and investors whose portfolio companies are
        talented, well-funded, and somehow still slow. Sometimes the right
        intervention is a fractional operator. Sometimes it's an honest sparring
        partner for the founder.
      </li>
      <li>
        And with leaders who sense that the hardest problem they're carrying
        is the one inside themselves, and want a sparring partner – privately –
        to create the space to share and work through it.
      </li>
    </ul>

    <p>
      Fewer companies than I could take. More depth with each.
    </p>

    <p>If any of that resonates, <button class="about-inline-trigger" data-contact-trigger>reach out</button>!</p>
  </section>

  <!-- Timeline -->
  <section class="about-timeline section container">
    <header class="about-timeline__header">
      <h2>Twenty years, compressed.</h2>
    </header>

    <p class="about-timeline__linkedin">Want the full detail? It's all on my <a href="https://linkedin.com/in/stevecattin" target="_blank" rel="noopener noreferrer">LinkedIn profile</a>.</p>

    <ol class="about-timeline__list">
      {milestones.map((m) => (
        <li class="about-timeline__item">
          <span class="about-timeline__year">{m.year}</span>
          <p class="about-timeline__note" set:html={m.note} />
        </li>
      ))}
    </ol>
  </section>

  <hr class="rule" />

  <!-- Principles -->
  <section class="about-principles section container">
    <header class="about-principles__header">
      <h2>My guiding principles.</h2>
    </header>

    <div class="about-principles__grid">
      {principles.map((p, i) => (
        <article class="about-principles__card">
          <span class="eyebrow eyebrow-amber">№ {String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>

    <p class="about-principles__link">The <a href="/practice">Work with me</a> page is where principles meet practice.</p>
  </section>

  <CTABlock
    id="book"
    eyebrow="Are we a match?"
    headline="Let's have the conversation before anything else."
    body="A twenty-minute intro call. No deck, no pre-work. I'll ask what's actually going on. If the fit is real, we'll both know by the end."
    ctaLabel="Reach out"
    ctaModal={true}
    secondaryLabel="Read some writing first"
    secondaryHref="/blog"
  />
</BaseLayout>

<style>
  /* -------- Hero -------- */
  .about-hero {
    padding-block: clamp(4rem, 4vw + 3rem, 7rem);
    max-width: 900px;
  }

  .about-hero .eyebrow {
    margin-bottom: var(--space-6);
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-6);
  }
  .about-hero__title .accent {
    color: var(--color-cobalt);
  }

  .about-hero__lede {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    max-width: 58ch;
  }

  /* -------- Body -------- */
  .about-body h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-12);
    margin-bottom: var(--space-5);
  }
  .about-body h2:first-child { margin-top: 0; }

  .about-body p {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    margin-bottom: var(--space-5);
    color: var(--color-ink);
  }

  .about-pullquote {
    border-left: 3px solid var(--color-cobalt);
    margin: var(--space-8) 0;
    padding: var(--space-6) var(--space-8);
    background: var(--color-mist);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    font-size: 1.12rem;
    line-height: var(--lh-prose);
    color: var(--color-ink);
    font-style: normal;
  }

  .about-pullquote strong {
    color: var(--color-cobalt);
    font-weight: 500;
  }

  .about-body ul {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-body ul li {
    font-size: 1.05rem;
    line-height: var(--lh-prose);
    color: var(--color-ink);
  }

  .about-betweens {
    list-style: none;
    padding-left: 0;
    counter-reset: betweens;
  }

  .about-betweens li {
    counter-increment: betweens;
    display: flex;
    gap: var(--space-5);
  }

  .about-betweens li::before {
    content: counter(betweens, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    flex-shrink: 0;
    padding-top: 0.25em;
  }

  .about-inline-trigger {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .about-inline-trigger:hover {
    color: var(--color-ink);
  }

  /* -------- Timeline -------- */
  .about-timeline__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }

  .about-timeline__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .about-timeline__linkedin {
    font-size: var(--text-sm);
    color: var(--color-graphite);
    margin-bottom: var(--space-8);
  }

  .about-timeline__linkedin a,
  .about-timeline__note a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-timeline__note a:hover {
    color: var(--color-ink);
  }

  .about-timeline__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .about-timeline__item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  .about-timeline__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .about-timeline__year {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-cobalt);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
  }

  .about-timeline__note {
    font-size: 1.02rem;
    line-height: var(--lh-normal);
    color: var(--color-ink);
    max-width: 60ch;
  }

  /* -------- Principles -------- */
  .about-principles__header {
    margin-bottom: var(--space-10);
    max-width: 680px;
  }

  .about-principles__header h2 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-3);
  }

  .about-principles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .about-principles__card {
    background: var(--color-mist);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-principles__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .about-principles__card p {
    font-size: 0.98rem;
    line-height: var(--lh-normal);
    color: var(--color-graphite);
  }

  .about-principles__link {
    margin-top: var(--space-10);
    font-size: 1.05rem;
    color: var(--color-graphite);
  }

  .about-principles__link a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 800px) {
    .about-timeline__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .about-principles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
