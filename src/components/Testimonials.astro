---
// Reusable "In their words" testimonials section.
// Source of truth for testimonial copy lives here; pages select which quotes
// to show via `featuredId` (large lead quote) and `rowIds` (quieter pair/row).
interface Props {
  eyebrow?: string;
  title?: string;
  featuredId?: string;
  rowIds?: string[];
  /** 'wide' (1340) for standalone sections, 'content' (1180) to sit flush
   *  with a page whose sections use .container. */
  width?: 'wide' | 'content';
  /** Featured quote becomes the section headline: large display type on a
   *  hanging quote mark (homepage). Pair with title="" to drop the h2. */
  lead?: boolean;
}

const TESTIMONIALS: Record<
  string,
  { quote: string; name: string; role: string; shortRole?: string; img: string }
> = {
  'karen-clarke': {
    quote:
      "Stève doesn't just deliver results – he builds high-performing teams. He energizes people, fosters creativity, and creates a real sense of ownership and alignment, paired with a structured approach that drives focus and performance.",
    name: 'Karen Clarke',
    role: 'Board Member, Advisor & CRO · Upstack, AMCS Group, Berkshire Partners',
    img: '/images/testimonials/karen-clarke.webp',
  },
  'christina-nahal': {
    quote:
      "I don't think there is anything that Stève can't do. His creativity and strategic guidance strengthened our brand across new markets, and his understanding of brand storytelling makes him an asset to any organization.",
    name: 'Christina Nahal',
    role: 'Marketing & Brand Advisor · former SVP of Marketing, Thirdera',
    img: '/images/testimonials/christina-nahal.webp',
  },
  'berin-sadikovic': {
    quote:
      'Stève was the ideal manager – leadership came naturally to him. He checked in on how the team was feeling, kept morale high, and gave us the space to own our work. His mentorship made me better, both professionally and personally.',
    name: 'Berin Sadikovic',
    role: 'IS Business Analyst, ABB',
    img: '/images/testimonials/berin-sadikovic.webp',
  },
  'kristin-johnsen': {
    quote:
      'Stève demonstrated great problem-solving skills as we worked to turn around the Tango GTM approach. He dug in to uncover root causes, laid out well-structured fixes that enabled strong cross-functional collaboration, and implemented measurement mechanisms so we could see what did or did not work.',
    name: 'Kristin Johnsen',
    role: 'Board Member, Tango · Advisory Director, Berkshire Partners · former Corporate VP, Enterprise Services, Microsoft',
    // Row cards are narrow – they use the short title when one is set.
    shortRole: 'Board Member, Tango · former Corporate VP, Microsoft',
    img: '/images/testimonials/kristin-johnsen.webp',
  },
  'benedikt-koppel': {
    quote:
      'Stève is genuinely AI-forward – learning, experimenting, and identifying where workflows can be simplified or automated, then turning those ideas into practical, repeatable ways of working.',
    name: 'Benedikt Köppel',
    role: 'Co-founder, Locatee · Head of AI Transformation, Tango',
    img: '/images/testimonials/benedikt-koppel.webp',
  },
  'nicolette-brenden': {
    quote:
      "Stève has a gift for putting the human in the work. He leads with structure and clear direction, but he never lets you forget that the people doing the work matter as much as the results. He's shaped how I think about leadership myself, and any organization that brings him on will feel that lasting impact.",
    name: 'Nicolette Brenden',
    role: 'B2B SaaS Marketing Leader · Senior Marketing Manager, Tango',
    img: '/images/testimonials/nicolette-brenden.webp',
  },
};

const {
  eyebrow = 'In their words',
  title = "What it's like to work with me.",
  featuredId,
  rowIds = [],
  width = 'wide',
  lead = false,
} = Astro.props;

const featured = featuredId ? TESTIMONIALS[featuredId] : null;
const rows = rowIds.map((id) => TESTIMONIALS[id]).filter(Boolean);

// Pass eyebrow="" and title="" to render a bare pull-quote with no heading –
// used when the section sits inside another section's argument.
const showHead = Boolean(eyebrow || title);
---

<section
  class:list={['voices', { 'voices--bare': !showHead, 'voices--lead': lead }]}
  aria-labelledby={showHead && title ? 'voices-title' : undefined}
  aria-label={showHead && title ? undefined : (eyebrow || 'In their words')}
>
  <div class={width === 'content' ? 'container' : 'container-wide'}>
    {showHead && (
      <header class="voices__head">
        {eyebrow && <p class="voices__eyebrow">{eyebrow}</p>}
        {title && <h2 id="voices-title" class="voices__title">{title}</h2>}
      </header>
    )}

    {featured && (
      <figure class="voices__featured">
        <span class="voices__mark" aria-hidden="true">&#8220;</span>
        <blockquote class="voices__lead">{featured.quote}</blockquote>
        <figcaption class="voices__by">
          <img
            class="voices__avatar"
            src={featured.img}
            alt={featured.name}
            width="112"
            height="112"
            loading="lazy"
            decoding="async"
          />
          <span class="voices__byline">
            <span class="voices__name">{featured.name}</span>
            <span class="voices__role">{featured.role}</span>
          </span>
        </figcaption>
      </figure>
    )}

    {rows.length > 0 && (
      <div class:list={['voices__row', { 'voices__row--lead': !featured, 'voices__row--three': rows.length === 3 || rows.length === 6, 'voices__row--four': rows.length === 4 }]}>
        {rows.map((t) => (
          <figure class="voices__item">
            <blockquote class="voices__quote">{t.quote}</blockquote>
            <figcaption class="voices__by">
              <img
                class="voices__avatar"
                src={t.img}
                alt={t.name}
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
              />
              <span class="voices__byline">
                <span class="voices__name">{t.name}</span>
                <span class="voices__role">{t.shortRole ?? t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* -------- Testimonials ("In their words") -------- */
  /* Editorial, chrome-less – same philosophy as the timeline and the About
     pullquote: type and hairlines carry it, no boxes. A featured quote leads
     (large, anchored by an oversized Cabinet Grotesk bold cobalt quote mark
     that echoes the hero's "stories" accent); quieter quotes follow in a
     hairline-separated row. */
  .voices {
    background: var(--color-paper);
    border-top: 0.5px solid var(--color-line);
    padding-block: var(--space-20);
  }

  /* Bare pull-quote variant – no heading, no top rule, sits inside a page's
     existing rhythm rather than announcing itself as a new section. */
  .voices--bare {
    border-top: none;
    padding-block: var(--space-12);
  }

  /* In the bare variant the quote is the whole point – let it run the full
     container and scale up. The oversized quote glyph is dropped: at this size
     the words carry themselves and the mark only eats vertical space. */
  .voices--bare .voices__featured {
    max-width: none;
    margin-bottom: 0;
  }

  .voices--bare .voices__mark {
    display: none;
  }

  .voices--bare .voices__lead {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
  }

  .voices__head {
    margin-bottom: var(--space-12);
    max-width: 680px;
  }

  .voices__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin: 0 0 var(--space-3);
  }

  .voices__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  /* Featured quote – the lead. Big Cabinet Grotesk bold glyph hangs above the quote,
     pulled left into the margin so the text aligns clean. */
  .voices__featured {
    margin: 0 0 var(--space-16);
    max-width: 60ch;
    position: relative;
  }

  .voices__mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 140px;
    line-height: 0.5;
    height: 64px;
    color: var(--color-cobalt);
    margin-bottom: var(--space-2);
    margin-left: -0.06em;
  }

  .voices__lead {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.5;
    letter-spacing: normal;
    color: var(--color-ink);
    margin: 0 0 var(--space-6);
  }

  /* Supporting pair – quieter, hairline above marks the shift in weight. */
  .voices__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-top: var(--space-10);
    border-top: 0.5px solid var(--color-line);
  }

  /* When the row is the lead (no featured quote above), drop the divider so
     it sits clean under the header. */
  .voices__row--lead {
    padding-top: 0;
    border-top: 0;
  }

  /* Three quotes in a row (no featured lead) – even thirds on desktop,
     stepping to two-up then one-up as width tightens. */
  .voices__row--three {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Four quotes under a lead – a single row on wide screens. */
  .voices__row--four {
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-10);
  }
  @media (max-width: 1180px) {
    .voices__row--four {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 980px) {
    .voices__row--three {
      grid-template-columns: 1fr 1fr;
    }
  }

  .voices__item {
    margin: 0;
  }

  .voices__quote {
    font-size: var(--text-base);
    line-height: var(--lh-prose);
    color: var(--color-graphite);
    margin: 0 0 var(--space-5);
  }

  /* Attribution – avatar + (name in display, role in mono).
     Shared by featured + items. */
  .voices__by {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .voices__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--color-mist);
  }

  .voices__featured .voices__avatar {
    width: 56px;
    height: 56px;
  }

  .voices__byline {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .voices__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .voices__role {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--color-ash);
    line-height: 1.5;
  }

  /* Lead variant – the featured quote is the headline. */
  .voices--lead .voices__head { margin-bottom: var(--space-10); }

  .voices--lead .voices__featured {
    max-width: none;
    padding-left: clamp(0px, 8.5vw, 120px);
    margin-bottom: var(--space-20);
  }

  .voices--lead .voices__mark {
    position: absolute;
    left: -0.04em;
    top: -14px;
    height: auto;
    margin: 0;
    font-size: 200px;
    line-height: 0.8;
  }

  .voices--lead .voices__lead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(26px, 2.7vw, 38px);
    line-height: 1.24;
    letter-spacing: -0.015em;
    max-width: 28em;
    margin-bottom: var(--space-8);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .voices--lead .voices__featured { padding-left: 0; }
    .voices--lead .voices__mark { position: static; display: block; font-size: 110px; height: 50px; line-height: 0.5; margin-bottom: var(--space-2); }
    .voices__row {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .voices__mark { font-size: 110px; height: 50px; }
  }

  @media (max-width: 640px) {
    .voices { padding-block: var(--space-16); }
  }
</style>
