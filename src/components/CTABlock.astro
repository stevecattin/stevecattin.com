---
export interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  id?: string;
}

const {
  eyebrow = 'Work with me',
  headline,
  body,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  id,
} = Astro.props;
---

<section class="cta" id={id}>
  <div class="container cta__inner">
    <p class="eyebrow eyebrow-amber">{eyebrow}</p>
    <h2 class="cta__headline">{headline}</h2>
    {body && <p class="cta__body">{body}</p>}

    <div class="cta__actions">
      <a href={ctaHref} class="cta__btn cta__btn--primary">{ctaLabel}</a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="cta__btn cta__btn--secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-24);
    margin-top: var(--space-16);
  }

  .cta__inner {
    max-width: 920px;
  }

  .cta .eyebrow {
    margin-bottom: var(--space-4);
  }

  .cta__headline {
    font-family: var(--font-display);
    font-size: var(--text-display);
    color: var(--color-paper);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-5);
    max-width: 22ch;
  }

  .cta__body {
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    line-height: var(--lh-normal);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .cta__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .cta__btn--primary {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }
  .cta__btn--primary:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .cta__btn--secondary {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
  }
  .cta__btn--secondary:hover {
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    color: var(--color-paper);
  }
</style>
