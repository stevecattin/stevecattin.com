---
export interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
  ctaLabel: string;
  ctaHref?: string;
  ctaModal?: boolean;
  secondaryLabel?: string;
  secondaryHref?: string;
  id?: string;
  /** Align to .container-wide (homepage) instead of the narrower .container. */
  wide?: boolean;
}

const {
  eyebrow = 'Work with me',
  headline,
  body,
  ctaLabel,
  ctaHref,
  ctaModal = false,
  secondaryLabel,
  secondaryHref,
  id,
  wide = false,
} = Astro.props;
---

<section class="cta" id={id}>
  <div class={wide ? 'container-wide cta__inner cta__inner--wide' : 'container cta__inner'}>
    <p class="cta__eyebrow">{eyebrow}</p>
    <h2 class="cta__headline">{headline}</h2>
    {body && <p class="cta__body">{body}</p>}

    <div class="cta__actions">
      {ctaModal
        ? <button class="cta__btn cta__btn--primary" data-contact-trigger>{ctaLabel}</button>
        : <a href={ctaHref} class="cta__btn cta__btn--primary">{ctaLabel}</a>
      }
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="cta__btn cta__btn--secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-24);
    margin-top: var(--space-16);
  }

  .cta__inner {
    max-width: 920px;
  }

  /* Wide variant: shares the page's left edge; the headline and body keep
     their own ch limits, so the line length doesn't change. */
  .cta__inner--wide {
    max-width: var(--max-w-wide);
  }

  .cta__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 60%, transparent);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .cta__headline {
    font-family: var(--font-display);
    font-size: var(--text-display);
    color: var(--color-paper);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-5);
    max-width: 22ch;
  }

  .cta__body {
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    line-height: var(--lh-normal);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .cta__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .cta__btn--primary {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }
  .cta__btn--primary:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .cta__btn--secondary {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
  }
  .cta__btn--secondary:hover {
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
    color: var(--color-paper);
  }
</style>
