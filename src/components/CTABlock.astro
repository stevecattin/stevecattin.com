---
export interface Props {
  /** Small mono label above the headline. Defaults to "Work with me";
   *  pass an empty string to show no label. */
  eyebrow?: string;
  headline: string;
  body?: string;
  ctaLabel: string;
  ctaHref?: string;
  ctaModal?: boolean;
  secondaryLabel?: string;
  secondaryHref?: string;
  id?: string;
  /** Align to .container-wide (homepage) instead of the narrower .container. */
  wide?: boolean;
  /** Navy band with moving gradient light + grain (homepage closing band). */
  night?: boolean;
}

const {
  eyebrow = 'Work with me',
  headline,
  body,
  ctaLabel,
  ctaHref,
  ctaModal = false,
  secondaryLabel,
  secondaryHref,
  id,
  wide = false,
  night = false,
} = Astro.props;
---

<section class:list={['cta', { 'cta--night': night }]} id={id}>
  {night && (
    <div class="night-bg" aria-hidden="true">
      <span class="night-bg__blob night-bg__blob--1 cta__blob--1"></span>
      <span class="night-bg__blob night-bg__blob--2 cta__blob--2"></span>
      <span class="night-bg__blob night-bg__blob--3 cta__blob--3"></span>
      <span class="night-bg__grain"></span>
    </div>
  )}
  <div class={wide ? 'container-wide cta__inner cta__inner--wide' : 'container cta__inner'}>
    {eyebrow && <p class="cta__eyebrow">{eyebrow}</p>}
    <h2 class="cta__headline">{headline}</h2>
    {body && <p class="cta__body">{body}</p>}
    {Astro.slots.has('default') && <div class="cta__extra"><slot /></div>}

    <div class="cta__actions">
      {ctaModal
        ? <button class="cta__btn cta__btn--primary" data-contact-trigger>{ctaLabel}</button>
        : <a href={ctaHref} class="cta__btn cta__btn--primary">{ctaLabel}</a>
      }
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="cta__btn cta__btn--secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-24);
    margin-top: var(--space-16);
  }

  .cta__inner {
    max-width: 920px;
  }

  /* Wide variant: shares the page's left edge; the headline and body keep
     their own ch limits, so the line length doesn't change. */
  .cta__inner--wide {
    max-width: var(--max-w-wide);
  }

  .cta__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 60%, transparent);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .cta__headline {
    font-family: var(--font-display);
    font-size: var(--text-display);
    color: var(--color-paper);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-5);
    max-width: 22ch;
  }

  .cta__body {
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    line-height: var(--lh-normal);
    max-width: 58ch;
    margin-bottom: var(--space-8);
  }

  .cta__extra { margin-bottom: var(--space-10); }

  .cta__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 13px 22px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .cta__btn--primary {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }
  .cta__btn--primary:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  /* Secondary path is a quiet text link, never a second button. */
  .cta__btn--secondary {
    background: transparent;
    color: var(--color-paper);
    padding-inline: var(--space-2);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-paper) 40%, transparent);
  }
  .cta__btn--secondary:hover {
    color: var(--color-paper);
    text-decoration-color: var(--color-paper);
  }

  /* -------- Night variant (closing band) --------
     Opens with a dusk instead of an edge: the first stretch of the band
     is sky that starts as the page itself (masked to transparent, so the
     page's light and grain run straight on) and darkens through the
     night blues into navy. The copy sits on the navy, below it. Mirror
     of the dawn that closes the AIMA night page. */
  .cta--night {
    --dusk-sky: clamp(200px, 22vw, 320px);
    position: relative;
    overflow: hidden;
    background: transparent;
    padding-top: calc(var(--dusk-sky) + var(--space-16));
    /* Anchor links (#book) land on the navy, not at the top of the sky. */
    scroll-margin-top: calc(var(--nav-h, 64px) - var(--dusk-sky));
  }

  .night-bg {
    background: linear-gradient(
      to bottom,
      var(--color-paper) 0,
      var(--color-night-powder) calc(var(--dusk-sky) * 0.12),
      var(--color-night-sky) calc(var(--dusk-sky) * 0.24),
      var(--color-night-azure) calc(var(--dusk-sky) * 0.38),
      var(--color-night-royal) calc(var(--dusk-sky) * 0.54),
      var(--color-night-deep) calc(var(--dusk-sky) * 0.74),
      var(--color-night) var(--dusk-sky)
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--dusk-sky) * 0.3));
    mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--dusk-sky) * 0.3));
  }

  .cta--night .cta__inner {
    position: relative;
    z-index: 1;
  }

  /* The night band closes the page: it sits flush on the footer's
     hairline, with or without the moving light around it. */
  :global(main:has(.cta--night) + .footer) {
    margin-top: 0;
  }

  /* Lights sit where they always did on the navy – moved down by the sky. */
  .cta__blob--1 {
    width: 760px; height: 760px; top: calc(var(--dusk-sky) - 260px); left: 53%;
    background: radial-gradient(circle at 60% 40%, var(--color-night-azure), var(--color-night-royal));
    filter: blur(182px);
    opacity: 0.7;
  }

  .cta__blob--2 {
    width: 620px; height: 620px; top: calc(var(--dusk-sky) + 120px); left: -120px;
    background: radial-gradient(circle at 30% 70%, var(--color-night-royal), var(--color-night-deep));
    filter: blur(148px);
    opacity: 0.7;
  }

  .cta__blob--3 {
    width: 300px; height: 300px; top: calc(var(--dusk-sky) + (100% - var(--dusk-sky)) * 0.43); left: 62%;
    background: radial-gradient(circle at 40% 40%, var(--color-night-coral-soft), var(--color-night-coral));
    filter: blur(72px);
    opacity: 0.7;
  }

  .cta--night .cta__eyebrow { color: var(--color-night-powder); }
  .cta--night .cta__body { color: var(--color-night-haze); }

  .cta--night .cta__btn--primary {
    background: var(--color-paper);
    color: var(--color-night);
  }
  .cta--night .cta__btn--primary:hover {
    background: var(--color-night-powder);
    color: var(--color-night);
  }

</style>
