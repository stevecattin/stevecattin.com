---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="nav">
  <div class="container-wide nav__inner">
    <a href="/" class="nav__brand" aria-label="Stève Cattin – home">
      <span class="nav__mark" aria-hidden="true">S.</span>
      <span class="nav__name">Stève Cattin</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="/" class:list={['nav__link', { 'is-active': isActive('/') }]}>Home</a>
      <a href="/about" class:list={['nav__link', { 'is-active': isActive('/about') }]}>About</a>
      <a href="/practice" class:list={['nav__link', { 'is-active': isActive('/practice') }]}>Practice</a>
      <a href="/blog" class:list={['nav__link', { 'is-active': isActive('/blog') }]}>Writing</a>
      <a href="mailto:hello@stevecattin.com?subject=Intro%20call" class="nav__cta">Book a call</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: var(--space-6);
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-ink);
  }

  .nav__brand:hover { color: var(--color-ink); }

  .nav__mark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-cobalt);
  }

  .nav__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-graphite);
    font-weight: 500;
  }

  .nav__link:hover { color: var(--color-ink); }
  .nav__link.is-active { color: var(--color-ink); }

  .nav__cta {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-paper);
    background: var(--color-ink);
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .nav__cta:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  @media (max-width: 640px) {
    .nav__name { display: none; }
    .nav__links { gap: var(--space-4); }
    .nav__link:not(.is-active):not(:last-of-type) {
      display: none;
    }
  }
</style>
