---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="nav">
  <div class="nav__shell">
    <div class="nav__inner">
      <a href="/" class="nav__brand" aria-label="Stève Cattin – home">
        <span class="nav__name">Stève Cattin</span>
        <span class="nav__role">CMO &amp; GTM Advisor</span>
      </a>

      <nav class="nav__links" aria-label="Primary">
        <a href="/practice" class:list={['nav__link', { 'is-active': isActive('/practice') }]}>Work with me</a>
        <a href="/about" class:list={['nav__link', { 'is-active': isActive('/about') }]}>About</a>
        <a href="/blog" class:list={['nav__link', { 'is-active': isActive('/blog') }]}>Writing</a>
        <button class="nav__cta" data-contact-trigger>Get in touch</button>
      </nav>

      <button class="nav__hamburger" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="nav__mobile-menu" aria-hidden="true">
      <a href="/practice" class:list={['nav__mobile-link', { 'is-active': isActive('/practice') }]}>Work with me</a>
      <a href="/about" class:list={['nav__mobile-link', { 'is-active': isActive('/about') }]}>About</a>
      <a href="/blog" class:list={['nav__mobile-link', { 'is-active': isActive('/blog') }]}>Writing</a>
      <button class="nav__mobile-cta" data-contact-trigger>Get in touch</button>
    </div>
  </div>
</header>

<script>
  const hamburger = document.querySelector('.nav__hamburger') as HTMLButtonElement;
  const mobileMenu = document.querySelector('.nav__mobile-menu') as HTMLElement;

  const setMenu = (open: boolean) => {
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.classList.toggle('is-open', open);
    hamburger.classList.toggle('is-open', open);
  };

  hamburger?.addEventListener('click', () => {
    setMenu(hamburger.getAttribute('aria-expanded') !== 'true');
  });

  // "Get in touch" opens the contact sheet – close the menu behind it, so
  // closing the sheet brings you back to the page, not the open menu.
  mobileMenu?.querySelector('[data-contact-trigger]')?.addEventListener('click', () => {
    setMenu(false);
  });
</script>

<style>
  /* v3 (Nov 2026): a compact navy bar floating centered at the top – the
     same on every page and every ground, opaque (no backdrop-filter, so
     nothing re-blurs over the moving lights). The role stays in the bar:
     the fastest answer to "what does he do". */
  :global(:root) { --nav-h: 80px; }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 20px 16px 0;
    pointer-events: none; /* only the bar itself takes clicks */
  }

  /* Pages without a full-bleed hero start below the bar. */
  :global(main:not(:has(.glow-scope, .v3-dusk, .v3-night--top))) {
    padding-top: var(--nav-h);
  }

  /* The panel: navy, grain, lift. On phones it also holds the menu. */
  .nav__shell {
    position: relative;
    pointer-events: auto;
    background: var(--color-night);
    border-radius: var(--radius-lg);
    box-shadow:
      0 18px 40px -18px rgba(15, 22, 51, 0.55),
      inset 0 1px 0 rgba(196, 214, 240, 0.2),
      0 0 0 1px rgba(196, 214, 240, 0.08);
    isolation: isolate;
    overflow: hidden;
  }

  /* Static overlay grain, like the night zones. */
  .nav__shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("/images/noise.png");
    background-size: 256px 256px;
    opacity: 0.2;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 8px 8px 22px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding-right: 22px;
    margin-right: 6px;
    border-right: 1px solid rgba(196, 214, 240, 0.25);
    color: var(--color-white);
  }
  .nav__brand:hover { color: var(--color-white); }

  .nav__name {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav__role {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-night-sky);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-night-powder);
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .nav__link:hover { color: var(--color-white); }
  .nav__link.is-active {
    color: var(--color-white);
    background: rgba(143, 176, 228, 0.16);
  }

  .nav__cta {
    margin-left: 6px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-cobalt);
    border: 0;
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .nav__cta:hover { background: var(--color-cobalt-deep); color: var(--color-white); }

  @media (max-width: 900px) {
    .nav__role { display: none; }
  }

  /* Hamburger — phones only. 44px square: Apple's minimum tap target. */
  .nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .nav__hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav__hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav__hamburger.is-open span:nth-child(2) { opacity: 0; }
  .nav__hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Phone menu: opens under the bar, inside the same navy panel. */
  .nav__mobile-menu {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-2) var(--space-4);
  }
  .nav__mobile-menu.is-open { display: flex; }

  .nav__mobile-link {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-night-powder);
    padding: var(--space-2) var(--space-3);
  }
  .nav__mobile-link:hover,
  .nav__mobile-link.is-active { color: var(--color-white); }

  .nav__mobile-cta {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-cobalt);
    padding: 14px 20px;
    border: 0;
    border-radius: var(--radius-sm);
    text-align: center;
  }

  @media (min-width: 641px) {
    .nav__mobile-menu { display: none !important; }
    .nav__hamburger { display: none !important; }
  }

  @media (max-width: 640px) {
    :global(:root) { --nav-h: 76px; }
    .nav { padding: 12px 12px 0; }
    .nav__shell { width: 100%; }
    .nav__inner { width: 100%; padding: 6px 6px 6px 18px; }
    .nav__links { display: none; }
    .nav__hamburger { display: flex; }
    .nav__brand { border-right: 0; padding-right: 0; margin-right: 0; }
  }
</style>
