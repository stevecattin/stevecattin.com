---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="nav">
  <div class="container-wide nav__inner">
    <a href="/" class="nav__brand" aria-label="Stève Cattin – home">
      <span class="nav__name">Stève Cattin</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="/practice" class:list={['nav__link', { 'is-active': isActive('/practice') }]}>Work with me</a>
      <a href="/about" class:list={['nav__link', { 'is-active': isActive('/about') }]}>About</a>
      <a href="/blog" class:list={['nav__link', { 'is-active': isActive('/blog') }]}>Writing</a>
      <button class="nav__cta" data-contact-trigger>Tell me your story</button>
    </nav>

    <button class="nav__hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav__mobile-menu" aria-hidden="true">
    <a href="/practice" class:list={['nav__mobile-link', { 'is-active': isActive('/practice') }]}>Work with me</a>
    <a href="/about" class:list={['nav__mobile-link', { 'is-active': isActive('/about') }]}>About</a>
    <a href="/blog" class:list={['nav__mobile-link', { 'is-active': isActive('/blog') }]}>Writing</a>
    <button class="nav__mobile-cta" data-contact-trigger>Tell me your story</button>
  </div>
</header>

<script>
  // Transparent over the page at the top; glass once the page moves.
  const navBar = document.querySelector<HTMLElement>('.nav');
  const syncNav = () => navBar?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', syncNav, { passive: true });
  syncNav();

  const hamburger = document.querySelector('.nav__hamburger') as HTMLButtonElement;
  const mobileMenu = document.querySelector('.nav__mobile-menu') as HTMLElement;

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu.setAttribute('aria-hidden', String(isOpen));
    mobileMenu.classList.toggle('is-open');
    hamburger.classList.toggle('is-open');
  });
</script>

<style>
  /* The bar floats over the page: no fill and no hairline at the top, so
     it sits in the hero's light; once the page scrolls it turns to liquid
     glass – translucent paper, strong blur, a light top edge, a soft lift. */
  :global(:root) { --nav-h: 64px; }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    transition:
      background-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      backdrop-filter 0.3s var(--ease-out),
      -webkit-backdrop-filter 0.3s var(--ease-out);
  }

  .nav.is-scrolled,
  .nav:has(.nav__mobile-menu.is-open) {
    background: color-mix(in srgb, var(--color-paper) 55%, transparent);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1px 0 rgba(255, 255, 255, 0.4),
      0 12px 32px -20px rgba(16, 17, 20, 0.28);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav.is-scrolled,
    .nav:has(.nav__mobile-menu.is-open) {
      background: var(--color-paper);
    }
  }

  /* Pages without the moving light start below the bar. */
  :global(main:not(:has(.glow-scope))) {
    padding-top: var(--nav-h);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: var(--space-6);
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-ink);
  }

  .nav__brand:hover { color: var(--color-ink); }


  .nav__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-graphite);
    font-weight: 500;
  }

  .nav__link:hover { color: var(--color-ink); }
  .nav__link.is-active { color: var(--color-ink); }

  .nav__cta {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-paper);
    background: var(--color-ink);
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .nav__cta:hover {
    background: var(--color-cobalt);
    color: var(--color-paper);
  }

  /* Hamburger — hidden on desktop */
  .nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav__hamburger.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__hamburger.is-open span:nth-child(2) {
    opacity: 0;
  }
  .nav__hamburger.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu — hidden by default, only shown on mobile */
  .nav__mobile-menu {
    display: none;
    flex-direction: column;
    padding: var(--space-6) var(--space-6) var(--space-8);
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .nav__mobile-menu.is-open {
    display: flex;
  }

  .nav__mobile-link {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-graphite);
    padding: var(--space-2) 0;
    text-decoration: none;
  }

  .nav__mobile-link:hover,
  .nav__mobile-link.is-active {
    color: var(--color-ink);
  }

  .nav__mobile-cta {
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-paper);
    background: var(--color-ink);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    text-align: center;
    text-decoration: none;
  }

  @media (min-width: 641px) {
    .nav__mobile-menu { display: none !important; }
    .nav__hamburger { display: none !important; }
  }

  @media (max-width: 640px) {
    .nav__links { display: none; }
    .nav__hamburger { display: flex; }

    .nav__inner {
      justify-content: space-between;
    }

    /* Center the name */
    .nav__brand {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
