---
export interface Props {
  href: string;
  title: string;
  category: string;
  pubDate: Date;
  readingTime?: string;
  wide?: boolean;
}

const { href, title, category, pubDate, readingTime, wide = false } = Astro.props;

// Direction 06 date format: 2026.04.12 (dotted, ISO-ish)
const y = pubDate.getFullYear();
const m = String(pubDate.getMonth() + 1).padStart(2, '0');
const d = String(pubDate.getDate()).padStart(2, '0');
const dateLabel = `${y}.${m}.${d}`;

// Reading time: "9 min" not "9 min read"
const readingLabel = readingTime ? readingTime.replace(/\s*read$/i, '') : null;
---

<a href={href} class:list={["post-card", { "post-card--wide": wide }]}>
  <div class="post-card__cat">{category}</div>
  <div class="post-card__title">{title}</div>
  <div class="post-card__meta">
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    {readingLabel && <> · {readingLabel}</>}
  </div>
</a>

<style>
  .post-card {
    display: block;
    padding: var(--space-4);
    background: var(--color-white);
    border: 0.5px solid var(--color-line);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform var(--dur-med) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-med) var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-cobalt);
    box-shadow: 0 4px 18px -8px rgba(40, 48, 255, 0.18);
    color: var(--color-ink);
  }

  .post-card__cat {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cobalt);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }

  .post-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    /* allow up to ~3 lines before clipping */
  }

  .post-card__meta {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    color: var(--color-ash);
    letter-spacing: var(--tracking-mono);
    margin-top: var(--space-3);
  }

  .post-card--wide {
    grid-column: span 2;
    padding: var(--space-6);
  }

  .post-card--wide .post-card__title {
    font-size: 18px;
    max-width: 30ch;
  }

  @media (max-width: 960px) {
    .post-card--wide {
      grid-column: span 1;
      padding: var(--space-4);
    }
    .post-card--wide .post-card__title {
      font-size: 15px;
    }
  }
</style>
