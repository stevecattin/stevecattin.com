---
/**
 * Facets — "Who is Stève" interactive self-portrait.
 * One unbroken ring (the whole person), six facets sitting ON it.
 * Click / tap a facet to reveal its voice + proof. Keyboard accessible.
 * Uses site tokens only (paper / ink / cobalt / mist). No imported fonts.
 */

interface Proof { l: string; b: string; }
interface Facet {
  ring: string;        // short label on the ring
  lines: string[];     // ring label split for legibility
  name: string;        // panel title
  voice: string[];
  proofs: Proof[];
}

const FACETS: Facet[] = [
  {
    ring: 'Operator',
    lines: ['Operator'],
    name: 'The Operator',
    voice: [
      "Most founders eventually hit the same strange gap. Every function has a head – sales, product, marketing, finance – but no one except them whose job is the whole picture.",
      "I've spent my whole career inside companies – on the executive team, next to the founder or CEO. Employed to build the story, the team, and the operating system underneath both.",
    ],
    proofs: [
      { l: 'Three functions, one company', b: "At Locatee my remit widened from Marketing to People to Operations – three functions held at once, as the company restructured and sold." },
      { l: "In the room where it's decided", b: "Senior Vice President and executive-leadership-team member at Tango; on the four-person deal team for Locatee's sale – with the co-CEOs, CFO and board, through two exits from the inside." },
      { l: 'I read what the company needs', b: "I've run messy early startups and worked inside Fortune 500s – so I can see what stage a company is in, what it needs next, and fix how it operates to get there." },
    ],
  },
  {
    ring: 'Storyteller',
    lines: ['Storyteller'],
    name: 'The Storyteller',
    voice: [
      "Marketing has been the through-line. Ask me what I actually do, and I'd say: I write the sentences that make a strategy legible – to the team that has to deliver it, and the market that has to buy it.",
      "Positioning, category, the narrative a founder can hand to their whole go-to-market. That's the craft.",
    ],
    proofs: [
      { l: 'Helped define the category', b: "Workplace analytics was barely a category before Locatee – I worked with the analysts drawing its lines (Verdantix, Forrester) and built the story that carried it to market." },
      { l: 'The story Sales took to market', b: "I built Locatee's whole narrative system – platform story, use-case stories, value story, flywheel story – so the team sold one coherent story, not ten." },
      { l: 'The story behind the raise and the sale', b: "I built the narrative both times it mattered most: the fundraise, alongside the CEO, and the story that carried Locatee through its acquisition." },
    ],
  },
  {
    ring: 'Culture Builder',
    lines: ['Culture', 'Builder'],
    name: 'The Culture Builder',
    voice: [
      "Culture isn't what you put on the wall. It's how work feels when nobody's watching – the rhythm that keeps a team moving, and the moments that keep it together.",
      "I've run teams on a weekly cadence, made space to celebrate the wins, and turned performance reviews into something people looked forward to. That's how you build a team that performs and wants to stay.",
    ],
    proofs: [
      { l: 'Accountability, built in rhythm', b: "I'm a Certified Aware Leader (Agile Leadership Journey), and I've run teams on sprints at FELFEL, Locatee and Tango – name the few things that matter, then look back at the close of each one. That's where accountability and momentum come from." },
      { l: 'Celebrate the wins', b: "When a team hits its goal, something happens – not always money, often just something fun. People need the moments as much as the numbers." },
      { l: 'The Performance Festival', b: "As Head of People I turned the whole performance cycle into a festival – one focused, high-energy week instead of a season everyone puts off. Reviews both ways, managers and employees, sessions on feedback and growth, and a gratitude wall to close." },
    ],
  },
  {
    ring: 'Demand Generator',
    lines: ['Demand', 'Generator'],
    name: 'The Demand Generator',
    voice: [
      "Growth is what happens when the craft delivers something the business can bank on. Not campaigns and impressions – pipeline, fundraises, sales cycles that shorten because the brand is doing its job.",
      "I've built demand engines from the founder's pitch through to the fundraise, in food-tech and in SaaS.",
    ],
    proofs: [
      { l: '175 to 500 customers, in two years', b: "At FELFEL I led growth as we went from 175 customers to 500, and from 20,000 users to 70,000 – a physical product taken into offices across Switzerland, not a landing page." },
      { l: 'Brand that paid its way', b: "At Locatee I made brand double as pipeline – the founders' film, the Workplace Leader podcast, thought leadership that generated demand instead of just awareness." },
      { l: 'Marketing the business can bank on', b: "At Tango my team sourced a large share of pipeline at a fraction of its cost – demand-gen held to a revenue standard, not a vanity one." },
    ],
  },
  {
    ring: 'Connector',
    lines: ['Connector'],
    name: 'The Cross-border Bridge',
    voice: [
      "Four languages, and enough working cultures under my belt to know that most misunderstandings between teams are cultural before they're anything else – long before they turn strategic, or personal.",
      "I've been international since day one – alumni events in Dubai and Brazil early on, European and North American teams ever since. I can usually feel when a room is about to misfire, before it does.",
    ],
    proofs: [
      { l: 'Built and ran teams across the Atlantic', b: "I opened Locatee's first US office from Zurich and hired the team in New York. At Tango I ran it the other way – in the US about a week in every six, my team spread across New York, Toronto, Boston, Florida and LA." },
      { l: 'Trained a Fortune 500 across EMEA', b: "At Parker Hannifin I rolled out marketing programs across the region – training 32 country divisions, from South Africa to Dubai to all of Europe." },
      { l: 'Four languages, four cultures', b: "French, English, German, Italian – and enough time in each to translate intent, not just words." },
    ],
  },
  {
    ring: 'Human',
    lines: ['Human'],
    name: 'The Human',
    voice: [
      "Business and the people who make it matter to me equally. Always have. I listen, I make it safe, and yes – I tell jokes.",
      "People remember how a room felt long after they forget what was said in it. That's the part I care most about getting right.",
    ],
    proofs: [
      { l: 'Hard calls, held with care', b: "I've let someone go who wasn't working out, and helped reshape a company through reorganization. The hardest part is what comes after – being there for the team that stays, steadying them through it, a walk outside or a coffee downstairs." },
      { l: "Honest, even when it's uncomfortable", b: "I stand up and have the real conversation – radical candor. I use coaching techniques to say what people need to hear, not what they want to, and to keep it kind." },
      { l: "I've been coached, and I coach", b: "Years in coaching myself, and mentoring inside Tango's program – I bring those techniques to keep a room safe enough for real risks. That's not soft. It's where the bold moves come from." },
    ],
  },
];

const CX = 300, CY = 300, R = 200, RL = 236;
const nodes = FACETS.map((f, i) => {
  const ang = ((-90 + i * 60) * Math.PI) / 180;
  const x = CX + R * Math.cos(ang);
  const y = CY + R * Math.sin(ang);
  const lx = CX + RL * Math.cos(ang);
  const ly = CY + RL * Math.sin(ang);
  const c = Math.cos(ang);
  const anchor = c > 0.2 ? 'start' : c < -0.2 ? 'end' : 'middle';
  const n = f.lines.length;
  const firstDy = 0.32 - (n - 1) * 0.525;
  return { ...f, i, x, y, lx, ly, anchor, firstDy };
});
---

<section class="facets container" aria-label="Who is Stève — six facets">
  <div class="facets__stage">
    <div class="facets__ringwrap">
      <svg class="facets__svg" viewBox="-50 30 700 560" data-active role="group" aria-label="Six facets of Stève on one ring">
        <circle class="facets__ring" cx={CX} cy={CY} r={R} />
        <circle class="facets__core" cx={CX} cy={CY} r="42" />
        <text class="facets__core-eyebrow" x={CX} y={CY - 8} text-anchor="middle">WHO IS</text>
        <text class="facets__core-name" x={CX} y={CY + 16} text-anchor="middle">Stève</text>

        {nodes.map((n) => (
          <g
            class="facets__node"
            data-i={n.i}
            role="button"
            tabindex="0"
            aria-pressed={n.i === 0 ? 'true' : 'false'}
            aria-label={n.name}
          >
            <circle class="facets__hit" cx={n.x} cy={n.y} r="38" />
            <circle class="facets__dot" cx={n.x} cy={n.y} r="11" />
            <text class="facets__label" x={n.lx} y={n.ly} text-anchor={n.anchor}>
              {n.lines.map((ln, k) => (
                <tspan x={n.lx} dy={`${k === 0 ? n.firstDy : 1.05}em`}>{ln}</tspan>
              ))}
            </text>
          </g>
        ))}
      </svg>
    </div>

    <div class="facets__panel" aria-live="polite">
      {FACETS.map((f, i) => (
        <div class="facets__view" data-panel={String(i)} hidden={i !== 0}>
          <p class="facets__facet-eyebrow">Facet {String(i + 1).padStart(2, '0')}</p>
          <h3 class="facets__facet-name">{f.name}</h3>
          {f.voice.map((v) => <p class="facets__voice">{v}</p>)}
          <p class="facets__proof-head">The proof underneath</p>
          {f.proofs.map((p) => (
            <div class="facets__proof">
              <p class="facets__proof-l">{p.l}</p>
              <p class="facets__proof-b">{p.b}</p>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .facets {
    padding-top: var(--space-10);
    padding-bottom: var(--space-24);
  }

  /* -------- Stage: ring + panel -------- */
  .facets__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
  }

  .facets__ringwrap {
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
  }

  .facets__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .facets__ring {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  .facets__core { fill: var(--color-ink); }

  .facets__core-eyebrow {
    fill: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
  }
  .facets__core-name {
    fill: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 23px;
  }

  /* -------- Nodes -------- */
  .facets__node { cursor: pointer; }
  .facets__node:focus { outline: none; }
  .facets__hit { fill: transparent; }

  .facets__dot {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 2;
    transition: fill var(--dur-med) var(--ease-out), stroke var(--dur-med) var(--ease-out);
  }

  .facets__label {
    fill: var(--color-graphite);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: fill var(--dur-med) var(--ease-out), opacity var(--dur-med) var(--ease-out);
    opacity: 0.72;
  }

  /* hover affordance on pointer devices (selection still happens on click) */
  @media (hover: hover) and (pointer: fine) {
    .facets__node:hover .facets__dot { fill: var(--color-ink); }
    .facets__node:hover .facets__label { opacity: 1; fill: var(--color-ink); }
  }

  /* keyboard focus ring */
  .facets__node:focus-visible .facets__dot {
    stroke: var(--color-cobalt);
    stroke-width: 3;
  }
  .facets__node:focus-visible .facets__label { opacity: 1; fill: var(--color-cobalt); }

  /* active state */
  .facets__node[aria-pressed='true'] .facets__dot {
    fill: var(--color-cobalt);
    stroke: var(--color-cobalt);
  }
  .facets__node[aria-pressed='true'] .facets__label {
    fill: var(--color-cobalt);
    opacity: 1;
  }
  .facets__svg[data-active] .facets__node:not([aria-pressed='true']) .facets__dot { opacity: 0.4; }
  .facets__svg[data-active] .facets__node:not([aria-pressed='true']) .facets__label { opacity: 0.32; }

  /* idle breathing until a facet is chosen */
  @keyframes facets-breathe { 0%, 100% { opacity: 0.5; } 50% { opacity: 0.92; } }
  @media (prefers-reduced-motion: no-preference) {
    .facets__svg:not([data-active]) .facets__dot { animation: facets-breathe 4.6s ease-in-out infinite; }
    .facets__node:nth-child(5) .facets__dot { animation-delay: 0s; }
    .facets__node:nth-child(6) .facets__dot { animation-delay: 0.4s; }
    .facets__node:nth-child(7) .facets__dot { animation-delay: 0.8s; }
    .facets__node:nth-child(8) .facets__dot { animation-delay: 1.2s; }
    .facets__node:nth-child(9) .facets__dot { animation-delay: 1.6s; }
    .facets__node:nth-child(10) .facets__dot { animation-delay: 2s; }
  }

  /* -------- Panel -------- */
  .facets__panel { min-height: 420px; }
  .facets__view[hidden] { display: none; }

  .facets__facet-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin: 0 0 var(--space-3);
  }
  .facets__facet-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-3xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
  }
  .facets__voice {
    font-size: var(--text-lg);
    line-height: var(--lh-normal);
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
  }
  .facets__proof-head {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ash);
    margin: var(--space-8) 0 var(--space-5);
    padding-top: var(--space-5);
    border-top: 0.5px solid var(--color-line);
  }
  .facets__proof { margin-bottom: var(--space-5); }
  .facets__proof-l {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-1);
  }
  .facets__proof-b {
    font-size: var(--text-base);
    line-height: var(--lh-normal);
    color: var(--color-graphite);
    margin: 0;
  }

  .facets__view:not([hidden]) { animation: facets-fade var(--dur-med) var(--ease-out); }
  @keyframes facets-fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .facets__view:not([hidden]) { animation: none; }
  }

  /* -------- Responsive -------- */
  @media (max-width: 880px) {
    .facets__stage {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .facets__ringwrap { max-width: 460px; }
    .facets__panel { min-height: 0; }
    .facets__label { font-size: 17px; }
  }

  @media (max-width: 520px) {
    .facets__ringwrap { max-width: 400px; }
    .facets__label { font-size: 19px; }
  }
</style>

<script>
  function initFacets(root: HTMLElement) {
    const svg = root.querySelector<SVGElement>('.facets__svg');
    const nodes = Array.from(root.querySelectorAll<SVGGElement>('.facets__node'));
    const views = Array.from(root.querySelectorAll<HTMLElement>('.facets__view'));
    if (!svg) return;

    function select(i: number) {
      svg!.setAttribute('data-active', '');
      nodes.forEach((n) => n.setAttribute('aria-pressed', Number(n.dataset.i) === i ? 'true' : 'false'));
      views.forEach((v) => { v.hidden = v.dataset.panel !== String(i); });
    }

    nodes.forEach((node) => {
      const i = Number(node.dataset.i);
      node.addEventListener('click', () => select(i));
      node.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(i); }
      });
    });

    select(0); // Operator active by default
  }

  document.querySelectorAll<HTMLElement>('.facets').forEach(initFacets);
</script>
