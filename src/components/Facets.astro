---
import NightLights from './NightLights.astro';
/**
 * Facets – "Who is Stève" as an accordion on night (P2, 20.11.2026).
 * Six rows, each with its opening line; open one to read its voice and
 * the proof underneath. A small ring lights the open facet's segment.
 * No scroll lock: the whole section fits in about one screen. Phones get
 * the proof headlines only, to stay light.
 */

interface Proof { l: string; b: string; }
interface Facet {
  ring: string;
  lines: string[];
  name: string;
  voice: string[];
  proofs: Proof[];
}

const FACETS: Facet[] = [
  {
    ring: 'Operator',
    lines: ['Operator'],
    name: 'The Operator',
    voice: [
      "Most founders eventually hit the same strange gap. Every function has a head – sales, product, marketing, finance – but no one except them whose job is the whole picture.",
      "I've spent my whole career inside companies – on the executive team, next to the founder or CEO. Employed to build the story, the team, and the operating system underneath both.",
    ],
    proofs: [
      { l: 'Three functions, one company', b: "At Locatee my remit widened from Marketing to People to Operations – three functions held at once, as the company restructured and sold." },
      { l: "In the room where it's decided", b: "Senior Vice President and executive-leadership-team member at Tango; on the four-person deal team for Locatee's sale – with the co-CEOs, CFO and board, through two exits from the inside." },
      { l: 'I read what the company needs', b: "I've run messy early startups and worked inside Fortune 500s – so I can see what stage a company is in, what it needs next, and fix how it operates to get there." },
    ],
  },
  {
    ring: 'Storyteller',
    lines: ['Storyteller'],
    name: 'The Storyteller',
    voice: [
      "Marketing has been the through-line. Ask me what I actually do, and I'd say: I write the sentences that make a strategy legible – to the team that has to deliver it, and the market that has to buy it.",
      "Positioning, category, the narrative a founder can hand to their whole go-to-market. That's the craft.",
    ],
    proofs: [
      { l: 'Helped define the category', b: "Workplace analytics was barely a category before Locatee – I worked with the analysts drawing its lines (Verdantix, Forrester) and built the story that carried it to market." },
      { l: 'The story Sales took to market', b: "I built Locatee's whole narrative system – platform story, use-case stories, value story, flywheel story – so the team sold one coherent story, not ten." },
      { l: 'The story behind the raise and the sale', b: "I built the narrative both times it mattered most: the fundraise, alongside the CEO, and the story that carried Locatee through its acquisition." },
    ],
  },
  {
    ring: 'Culture Builder',
    lines: ['Culture', 'Builder'],
    name: 'The Culture Builder',
    voice: [
      "Culture isn't what you put on the wall. It's how work feels when nobody's watching – the rhythm that keeps a team moving, and the moments that keep it together.",
      "I've run teams on a weekly cadence, made space to celebrate the wins, and turned performance reviews into something people looked forward to. That's how you build a team that performs and wants to stay.",
    ],
    proofs: [
      { l: 'Accountability, built in rhythm', b: "I'm a Certified Aware Leader (Agile Leadership Journey), and I've run teams on sprints at FELFEL, Locatee and Tango – name the few things that matter, then look back at the close of each one. That's where accountability and momentum come from." },
      { l: 'Celebrate the wins', b: "When a team hits its goal, something happens – not always money, often just something fun. People need the moments as much as the numbers." },
      { l: 'The Performance Festival', b: "As Head of People I turned the whole performance cycle into a festival – one focused, high-energy week instead of a season everyone puts off. Reviews both ways, managers and employees, sessions on feedback and growth, and a gratitude wall to close." },
    ],
  },
  {
    ring: 'Demand Generator',
    lines: ['Demand', 'Generator'],
    name: 'The Demand Generator',
    voice: [
      "Growth is what happens when the craft delivers something the business can bank on. Not campaigns and impressions – pipeline, fundraises, sales cycles that shorten because the brand is doing its job.",
      "I've built demand engines from the founder's pitch through to the fundraise, in food-tech and in SaaS.",
    ],
    proofs: [
      { l: '175 to 500 customers, in two years', b: "At FELFEL I led growth as we went from 175 customers to 500, and from 20,000 users to 70,000 – a physical product taken into offices across Switzerland, not a landing page." },
      { l: 'Brand that paid its way', b: "At Locatee I made brand double as pipeline – the founders' film, the Workplace Leader podcast, thought leadership that generated demand instead of just awareness." },
      { l: 'Marketing the business can bank on', b: "At Tango my team sourced a large share of pipeline at a fraction of its cost – demand-gen held to a revenue standard, not a vanity one." },
    ],
  },
  {
    ring: 'Connector',
    lines: ['Connector'],
    name: 'The Cross-border Bridge',
    voice: [
      "Four languages, and enough working cultures under my belt to know that most misunderstandings between teams are cultural before they're anything else – long before they turn strategic, or personal.",
      "I've been international since day one – alumni events in Dubai and Brazil early on, European and North American teams ever since. I can usually feel when a room is about to misfire, before it does.",
    ],
    proofs: [
      { l: 'Built and ran teams across the Atlantic', b: "I opened Locatee's first US office from Zurich and hired the team in New York. At Tango I ran it the other way – in the US about a week in every six, my team spread across New York, Toronto, Boston, Florida and LA." },
      { l: 'Trained a Fortune 500 across EMEA', b: "At Parker Hannifin I rolled out marketing programs across the region – training 32 country divisions, from South Africa to Dubai to all of Europe." },
      { l: 'Four languages, four cultures', b: "French, English, German, Italian – and enough time in each to translate intent, not just words." },
    ],
  },
  {
    ring: 'Human',
    lines: ['Human'],
    name: 'The Human',
    voice: [
      "Business and the people who make it matter to me equally. Always have. I listen, I make it safe, and yes – I tell jokes.",
      "People remember how a room felt long after they forget what was said in it. That's the part I care most about getting right.",
    ],
    proofs: [
      { l: 'Hard calls, held with care', b: "I've let someone go who wasn't working out, and helped reshape a company through reorganization. The hardest part is what comes after – being there for the team that stays, steadying them through it, a walk outside or a coffee downstairs." },
      { l: "Honest, even when it's uncomfortable", b: "I stand up and have the real conversation – radical candor. I use coaching techniques to say what people need to hear, not what they want to, and to keep it kind." },
      { l: "I've been coached, and I coach", b: "Years in coaching myself, and mentoring inside Tango's program – I bring those techniques to keep a room safe enough for real risks. That's not soft. It's where the bold moves come from." },
    ],
  },
];

const N = FACETS.length;
const SEG = ['#2830FF', '#4D5BFF', '#7A63D8', '#B46BB0', '#D86C86', '#F96B54'];
const C = 120, R = 80;
const r1 = (v: number) => Math.round(v * 10) / 10;
const polar = (deg: number, rad: number) => {
  const a = (deg * Math.PI) / 180;
  return [r1(C + rad * Math.cos(a)), r1(C + rad * Math.sin(a))];
};
const nodes = FACETS.map((f, i) => {
  const deg = -90 + (i * 360) / N;
  const [x, y] = polar(deg, R);
  const [sx, sy] = polar(deg, R);
  const [ex, ey] = polar(deg + 360 / N, R);
  return { i, x, y, arc: `M ${sx} ${sy} A ${R} ${R} 0 0 1 ${ex} ${ey}`, color: SEG[i] };
});
const firstLine = (v: string) => (v.match(/^.*?[.!?](\s|$)/)?.[0] ?? v).trim();
---

<section class="facets" aria-label="Who is Stève – six facets">
  <NightLights coral grain={false} />
  <div class="container-wide facets__grid">
    <div class="facets__ring" aria-hidden="true">
      <svg viewBox="0 0 240 240" class="facets__svg">
        <circle class="facets__ghost" cx={C} cy={C} r={R} />
        {nodes.map((n) => (
          <path class="facets__arc" data-arc={n.i} d={n.arc} style={`stroke: ${n.color}`} />
        ))}
        {nodes.map((n) => (
          <g class="facets__node" data-node={n.i} style={`--seg: ${n.color}`}>
            <circle class="facets__halo" cx={n.x} cy={n.y} r="16" />
            <circle class="facets__dot" cx={n.x} cy={n.y} r="6" />
          </g>
        ))}
        <circle class="facets__core" cx={C} cy={C} r="30" />
        <text class="facets__core-eyebrow" x={C} y={C - 4} text-anchor="middle">WHO IS</text>
        <text class="facets__core-name" x={C} y={C + 13} text-anchor="middle">Stève</text>
      </svg>
    </div>

    <div class="facets__list">
      {FACETS.map((f, i) => (
        <div class:list={['facets__row', { 'is-open': i === 0 }]} style={`--seg: ${SEG[i]}`}>
          <h3 class="facets__head">
            <button
              class="facets__btn"
              type="button"
              id={`facet-btn-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`facet-panel-${i}`}
              data-i={i}
            >
              <span class="facets__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="facets__name">{f.name}</span>
              <span class="facets__first">{firstLine(f.voice[0])}</span>
              <span class="facets__sign" aria-hidden="true"></span>
            </button>
          </h3>
          <div
            class="facets__panel"
            id={`facet-panel-${i}`}
            role="region"
            aria-labelledby={`facet-btn-${i}`}
            hidden={i !== 0}
          >
            <div class="facets__voice">
              {f.voice.map((v) => <p>{v}</p>)}
            </div>
            <ul class="facets__proofs" aria-label="The proof underneath">
              {f.proofs.map((p) => (
                <li class="facets__proof">
                  <p class="facets__proof-l">{p.l}</p>
                  <p class="facets__proof-b">{p.b}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .facets {
    position: relative;
    isolation: isolate;
    padding-block: 96px 40px;
  }
  .facets > :global(.v3-lights) { --dawn: 0px; }

  .facets__grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: start;
  }

  /* -------- The small ring -------- */
  .facets__ring { position: sticky; top: 120px; }
  .facets__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .facets__ghost { fill: none; stroke: var(--color-night-powder); stroke-opacity: 0.3; stroke-width: 1.5; stroke-dasharray: 2 6; }
  .facets__arc { fill: none; stroke-width: 4; opacity: 0; transition: opacity var(--dur-med) var(--ease-out); }
  .facets__arc.is-on { opacity: 1; }
  .facets__halo { fill: var(--seg); opacity: 0; transition: opacity var(--dur-med) var(--ease-out); }
  .facets__dot {
    fill: var(--color-night);
    stroke: var(--color-night-powder);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
    transition: fill var(--dur-med) var(--ease-out), stroke var(--dur-med) var(--ease-out);
  }
  .facets__node { cursor: pointer; }
  .facets__node.is-on .facets__halo { opacity: 0.35; }
  .facets__node.is-on .facets__dot { fill: var(--seg); stroke: var(--seg); stroke-opacity: 1; }
  .facets__core { fill: var(--color-night-royal); stroke: rgba(196, 214, 240, 0.7); stroke-width: 1; }
  .facets__core-eyebrow { fill: var(--color-night-powder); font-family: var(--font-mono); font-size: 7px; letter-spacing: 0.2em; }
  .facets__core-name { fill: var(--color-white); font-family: var(--font-display); font-weight: 600; font-size: 15px; }

  /* -------- Rows -------- */
  .facets__row { border-top: 1px solid rgba(196, 214, 240, 0.18); }
  .facets__row:last-child { border-bottom: 1px solid rgba(196, 214, 240, 0.18); }
  .facets__head { margin: 0; }
  .facets__btn {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: grid;
    grid-template-columns: 56px minmax(0, 300px) minmax(0, 1fr) 32px;
    gap: 20px;
    align-items: baseline;
    padding-block: 20px;
    cursor: pointer;
    color: var(--color-white);
  }
  .facets__btn:focus-visible { outline: 2px solid var(--color-night-sky); outline-offset: 4px; border-radius: 2px; }
  .facets__n {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--seg);
  }
  .facets__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 1rem + 0.8vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .facets__first { font-size: 15px; line-height: 1.5; color: var(--color-night-powder); }
  .is-open .facets__first { visibility: hidden; }
  .facets__sign { position: relative; justify-self: end; width: 14px; height: 14px; align-self: center; }
  .facets__sign::before,
  .facets__sign::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-night-sky);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .facets__sign::after { transform: rotate(90deg); }
  .is-open .facets__sign::after { transform: rotate(0deg); }
  @media (hover: hover) and (pointer: fine) {
    .facets__btn:hover .facets__name { color: var(--color-night-sky); }
  }

  /* -------- Open panel -------- */
  .facets__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px 40px;
    padding: 0 0 28px 76px;
    animation: facets-in 360ms var(--ease-out);
  }
  .facets__panel[hidden] { display: none; }
  @keyframes facets-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .facets__voice p { margin: 0 0 var(--space-3); font-size: 17px; line-height: 1.6; color: var(--color-night-haze); }
  .facets__voice p:last-child { margin-bottom: 0; }
  .facets__proofs { list-style: none; margin: 0; padding: 0; }
  .facets__proof { padding-block: 12px; border-top: 1px solid rgba(196, 214, 240, 0.18); }
  .facets__proof:first-child { border-top: 0; padding-top: 0; }
  .facets__proof-l {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-white);
  }
  .facets__proof-b { margin: 0; font-size: 14px; line-height: 1.55; color: var(--color-night-powder); }

  @media (prefers-reduced-motion: reduce) {
    .facets__panel { animation: none; }
  }

  /* -------- Tablet and phone -------- */
  @media (max-width: 960px) {
    .facets { padding-top: 64px; }
    .facets__grid { grid-template-columns: 1fr; gap: 16px; }
    .facets__ring { position: static; width: 170px; margin-inline: auto; }
    .facets__btn {
      grid-template-columns: 32px minmax(0, 1fr) 20px;
      grid-template-areas: "n name sign" ". first first";
      row-gap: 6px;
      gap: 12px;
      padding-block: 16px;
    }
    .facets__n { grid-area: n; }
    .facets__name { grid-area: name; font-size: 20px; }
    .facets__first { grid-area: first; font-size: 13px; }
    .is-open .facets__first { display: none; }
    .facets__sign { grid-area: sign; }
    .facets__panel { grid-template-columns: 1fr; padding-left: 44px; gap: 14px; }
    .facets__voice p { font-size: 15px; }
    /* Phones: proof headlines only – light, but the evidence stays. */
    .facets__proof-b { display: none; }
    .facets__proof { padding-block: 8px; }
    .facets__proof-l { font-size: 15px; margin: 0; }
  }
</style>

<script>
  function initFacets(root: HTMLElement) {
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.facets__row'));
    const btns = rows.map((r) => r.querySelector<HTMLButtonElement>('.facets__btn')!);
    const panels = rows.map((r) => r.querySelector<HTMLElement>('.facets__panel')!);
    const arcs = Array.from(root.querySelectorAll<SVGPathElement>('.facets__arc'));
    const nodes = Array.from(root.querySelectorAll<SVGGElement>('.facets__node'));

    function show(open: number) {
      rows.forEach((r, k) => {
        const on = k === open;
        r.classList.toggle('is-open', on);
        btns[k].setAttribute('aria-expanded', on ? 'true' : 'false');
        panels[k].hidden = !on;
      });
      arcs.forEach((a) => a.classList.toggle('is-on', Number(a.dataset.arc) === open));
      nodes.forEach((n) => n.classList.toggle('is-on', Number(n.dataset.node) === open));
    }

    btns.forEach((b, k) => b.addEventListener('click', () => {
      show(rows[k].classList.contains('is-open') ? -1 : k);
    }));
    nodes.forEach((n) => n.addEventListener('click', () => {
      const k = Number(n.dataset.node);
      show(k);
      btns[k].focus({ preventScroll: true });
    }));
    show(0);
  }
  document.querySelectorAll<HTMLElement>('.facets').forEach(initFacets);
</script>
