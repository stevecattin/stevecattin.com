---
/**
 * FacetMoments – About's signature object (v2.1, rebuilt Oct 2, 2026).
 * The six-facet ring stays sticky on the left; the four moments from
 * Work with me run as hairline rows on the right. As each moment reaches
 * the reading line, the ring lights the facets it calls on, and the closing
 * line lights all six. Nothing is pinned: the page scrolls normally.
 * Without JS, on phones and narrow screens, the ring simply shows complete.
 */
type FacetKey = 'operator' | 'storyteller' | 'culture' | 'demand' | 'connector' | 'human';
interface Moment { title: string; body: string; facets: FacetKey[]; }
interface Props {
  eyebrow?: string;
  title: string;
  moments: Moment[];
  coda?: string;
}

const { eyebrow, title, moments, coda } = Astro.props;

const FACETS: { key: FacetKey; label: string; lines: string[] }[] = [
  { key: 'operator',    label: 'Operator',         lines: ['Operator'] },
  { key: 'storyteller', label: 'Storyteller',      lines: ['Storyteller'] },
  { key: 'culture',     label: 'Culture Builder',  lines: ['Culture', 'Builder'] },
  { key: 'demand',      label: 'Demand Generator', lines: ['Demand', 'Generator'] },
  { key: 'connector',   label: 'Connector',        lines: ['Connector'] },
  { key: 'human',       label: 'Human',            lines: ['Human'] },
];
const labelOf = Object.fromEntries(FACETS.map((f) => [f.key, f.label])) as Record<FacetKey, string>;

const N = FACETS.length;
const CX = 300, CY = 300, R = 200, RL = 240;
// Same palette as the AIMA beam: cobalt → violet → coral, once around.
const SEG_COLORS = ['#2830FF', '#4D5BFF', '#7A63D8', '#B46BB0', '#D86C86', '#F96B54'];
const r1 = (v: number) => Math.round(v * 10) / 10;
const polar = (deg: number, rad: number) => {
  const a = (deg * Math.PI) / 180;
  return [CX + rad * Math.cos(a), CY + rad * Math.sin(a)];
};
const half = 180 / N; // each facet owns the arc centred on its dot
const nodes = FACETS.map((f, i) => {
  const deg = -90 + (i * 360) / N;
  const [x, y] = polar(deg, R);
  const [lx, ly] = polar(deg, RL);
  const c = Math.cos((deg * Math.PI) / 180);
  const anchor = c > 0.2 ? 'start' : c < -0.2 ? 'end' : 'middle';
  const firstDy = 0.35 - (f.lines.length - 1) * 0.55;
  const [sx, sy] = polar(deg - half, R);
  const [ex, ey] = polar(deg + half, R);
  const arc = `M ${r1(sx)} ${r1(sy)} A ${R} ${R} 0 0 1 ${r1(ex)} ${r1(ey)}`;
  return { ...f, i, x: r1(x), y: r1(y), lx: r1(lx), ly: r1(ly), anchor, firstDy, arc, color: SEG_COLORS[i] };
});
const ringLabel = `Six facets of Stève on one ring: ${FACETS.map((f) => f.label).join(', ')}. Each moment lights the facets it calls on.`;
---

<section class="v2-section fm" aria-labelledby="fm-title">
  <div class="container-wide">
    <header class="fm__head">
      {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
      <h2 id="fm-title" class="section-title">{title}</h2>
    </header>

    <div class="v2-split fm__split">
      <div class="fm__ringcol">
        <figure class="fm__ringwrap">
          <svg class="fm__svg" viewBox="-70 40 740 520" role="img" aria-label={ringLabel}>
            <defs>
              <filter id="fm-halo" x="-150%" y="-150%" width="400%" height="400%">
                <feGaussianBlur stdDeviation="9" />
              </filter>
              <filter id="fm-arc-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="7" />
              </filter>
            </defs>

            <!-- The whole person, before a moment calls on any part of it -->
            <circle class="fm__ghost" cx={CX} cy={CY} r={R} />

            <g class="fm__arcs-glow" filter="url(#fm-arc-glow)" aria-hidden="true">
              {nodes.map((n) => <path class="fm__arc" data-key={n.key} d={n.arc} pathLength="1" style={`stroke: ${n.color}`} />)}
            </g>
            <g class="fm__arcs" aria-hidden="true">
              {nodes.map((n) => <path class="fm__arc" data-key={n.key} d={n.arc} pathLength="1" style={`stroke: ${n.color}`} />)}
            </g>

            {nodes.map((n) => (
              <path class="fm__spoke" data-key={n.key} d={`M ${CX} ${CY} L ${n.x} ${n.y}`} pathLength="1" style={`stroke: ${n.color}`} />
            ))}

            <circle class="fm__core-glow" cx={CX} cy={CY} r="64" filter="url(#fm-halo)" />
            <circle class="fm__core" cx={CX} cy={CY} r="48" />
            <text class="fm__core-eyebrow" x={CX} y={CY - 8} text-anchor="middle">WHO IS</text>
            <text class="fm__core-name" x={CX} y={CY + 18} text-anchor="middle">Stève</text>

            {nodes.map((n) => (
              <g class="fm__node" data-key={n.key} style={`--seg: ${n.color}`}>
                <circle class="fm__halo" cx={n.x} cy={n.y} r="26" filter="url(#fm-halo)" />
                <circle class="fm__dot" cx={n.x} cy={n.y} r="10" />
                <text class="fm__label" x={n.lx} y={n.ly} text-anchor={n.anchor}>
                  {n.lines.map((ln, k) => <tspan x={n.lx} dy={`${k === 0 ? n.firstDy : 1.1}em`}>{ln}</tspan>)}
                </text>
              </g>
            ))}
          </svg>
          <figcaption class="fm__caption">Six facets, one person. Each moment calls on some of them.</figcaption>
        </figure>
      </div>

      <div class="fm__rows">
        <ol class="fm__list">
          {moments.map((m, i) => (
            <li class="fm__item" data-facets={m.facets.join(' ')}>
              <span class="fm__num">№ {String(i + 1).padStart(2, '0')}</span>
              <h3 class="fm__title">{m.title}</h3>
              <p class="fm__body">{m.body}</p>
              <p class="fm__tags"><span class="fm__tags-l">Calls on</span> {m.facets.map((k) => labelOf[k]).join(' · ')}</p>
            </li>
          ))}
        </ol>
        {coda && <p class="fm__coda" data-facets="all">{coda}</p>}
      </div>
    </div>
  </div>
</section>

<style>
  .fm__head { margin-bottom: var(--space-16); max-width: 22em; }

  .fm__split { align-items: start; }

  /* The ring holds still beside the rows – sticky, not pinned: the page
     keeps its normal scroll. */
  .fm__ringcol { position: sticky; top: 112px; }
  .fm__ringwrap { margin: 0; max-width: 480px; }
  .fm__svg { width: 100%; height: auto; display: block; overflow: visible; }

  .fm__caption {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-ash);
    max-width: 34ch;
  }

  /* -------- Ring: complete by default (no JS, phones) -------- */
  .fm__ghost { fill: none; stroke: var(--color-ink); stroke-opacity: 0.14; stroke-width: 1.5; stroke-dasharray: 2 6; }
  .fm__arc {
    fill: none;
    stroke-width: 4;
    stroke-linecap: butt;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--ease-out), opacity 600ms var(--ease-out);
  }
  .fm__arcs-glow .fm__arc { stroke-width: 10; opacity: 0.4; }

  .fm__spoke {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    transition: stroke-dashoffset 600ms var(--ease-out);
  }

  .fm__core { fill: var(--color-ink); }
  .fm__core-glow { fill: var(--color-glow-blue); opacity: 0.5; transition: opacity 900ms var(--ease-out); }
  .fm__core-eyebrow { fill: var(--color-paper); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em; }
  .fm__core-name { fill: var(--color-paper); font-family: var(--font-display); font-weight: 500; font-size: 25px; }

  .fm__halo { fill: var(--seg); opacity: 0.45; transition: opacity var(--dur-slow) var(--ease-out); }
  .fm__dot {
    fill: var(--seg);
    stroke: var(--seg);
    stroke-width: 1.5;
    transition: fill var(--dur-med) var(--ease-out), stroke var(--dur-med) var(--ease-out);
  }
  .fm__label {
    fill: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: fill var(--dur-med) var(--ease-out);
  }

  /* -------- Live: only the facets the current moment calls on are lit -------- */
  .fm.is-live .fm__arc { stroke-dashoffset: 1; }
  .fm.is-live .fm__arc.is-lit { stroke-dashoffset: 0; }
  .fm.is-live .fm__spoke.is-lit { stroke-dashoffset: 0; }
  .fm.is-live .fm__core-glow { opacity: 0; }
  .fm.is-live.is-all .fm__core-glow { opacity: 0.5; }
  .fm.is-live .fm__halo { opacity: 0; }
  .fm.is-live .fm__node.is-lit .fm__halo { opacity: 0.55; }
  .fm.is-live .fm__dot { fill: var(--color-paper); stroke: var(--color-ink); stroke-opacity: 0.35; }
  .fm.is-live .fm__node.is-lit .fm__dot { fill: var(--seg); stroke: var(--seg); stroke-opacity: 1; }
  .fm.is-live .fm__label { fill: var(--color-ash); }
  .fm.is-live .fm__node.is-lit .fm__label { fill: var(--color-ink); }

  @media (prefers-reduced-motion: reduce) {
    .fm__arc, .fm__spoke, .fm__halo, .fm__dot, .fm__label, .fm__core-glow { transition: none; }
  }

  /* -------- Moments: hairline rows -------- */
  .fm__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .fm__item {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-line);
  }
  .fm__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cobalt);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .fm__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
    max-width: 26em;
    text-wrap: balance;
  }
  .fm__body {
    font-size: 17px;
    line-height: var(--lh-prose);
    color: var(--color-graphite);
    margin: 0;
    max-width: 60ch;
  }
  .fm__tags {
    margin: var(--space-5) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-graphite);
  }
  .fm__tags-l { color: var(--color-ash); margin-right: var(--space-2); }

  .fm__coda {
    margin: var(--space-12) 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 22em;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    .fm__head { margin-bottom: var(--space-10); }
    .fm__ringcol { position: static; }
    .fm__ringwrap { max-width: 340px; margin-inline: auto; }
    .fm__caption { text-align: center; margin-inline: auto; }
    .fm__label { font-size: 22px; }
  }
  @media (max-width: 640px) {
    .fm__item { padding-block: var(--space-10); }
  }
</style>

<script>
  function initFacetMoments(root: HTMLElement) {
    const marks = Array.from(root.querySelectorAll<SVGElement>('.fm__node, .fm__arc, .fm__spoke'));
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.fm__rows [data-facets]'));
    const wide = window.matchMedia('(min-width: 861px)');
    let live = false;
    let current: string | null = null;
    let ticking = false;

    function light(set: string) {
      if (set === current) return;
      current = set;
      const all = set === 'all';
      const keys = new Set(set.split(' ').filter(Boolean));
      marks.forEach((el) => el.classList.toggle('is-lit', all || keys.has(el.dataset.key ?? '')));
      root.classList.toggle('is-all', all);
    }

    // The moment whose top has passed the reading line (55% down) is current.
    function update() {
      ticking = false;
      if (!live) return;
      const line = window.innerHeight * 0.55;
      let set = '';
      steps.forEach((el) => { if (el.getBoundingClientRect().top <= line) set = el.dataset.facets ?? ''; });
      light(set);
    }

    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

    function setMode() {
      live = wide.matches;
      root.classList.toggle('is-live', live);
      current = null;
      if (live) update();
      else { marks.forEach((el) => el.classList.remove('is-lit')); root.classList.remove('is-all'); }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    wide.addEventListener('change', setMode);
    setMode();
  }

  document.querySelectorAll<HTMLElement>('.fm').forEach(initFacetMoments);
</script>
